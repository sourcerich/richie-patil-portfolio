---
// Day/night switch: a pill with both states in it, the sun (day, warm
// paper) on the left and the monsoon storm cloud (night, kaali-peeli) on
// the right, with a thumb that slides to the one in use. The starting mode
// is set before first paint by the inline script in Base.astro and the
// thumb's position comes from html[data-mode] in CSS, so there is no flash;
// clicking flips it and saves the choice for the next visit.
---

<button type="button" class="theme-toggle" role="switch" aria-checked="false" aria-label="Dark mode">
  <span class="thumb" aria-hidden="true"></span>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="icon sun">
    <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
    </g>
  </svg>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="icon cloud">
    <!-- Shifted so the cloud and bolt together are centred on (12, 12). -->
    <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" transform="translate(.32 -.36)">
      <path d="M7.2 16.2H6.5a3.9 3.9 0 0 1-.4-7.8 5.4 5.4 0 0 1 10.4-1.2 4.5 4.5 0 0 1 .9 8.9"></path>
      <path d="M12.6 12.2l-2.6 4.3h3.2l-2.4 4.5"></path>
    </g>
  </svg>
</button>

<script>
  // Keep in sync with --color-bg in main.css and the inline script.
  const THEME_COLORS = { light: '#f3ebd6', dark: '#141311' }
  const root = document.documentElement

  const sync = () => {
    const dark = root.dataset.mode === 'dark'
    for (const button of document.querySelectorAll('.theme-toggle')) {
      button.setAttribute('aria-checked', String(dark))
    }
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', THEME_COLORS[dark ? 'dark' : 'light'])
  }

  for (const button of document.querySelectorAll('.theme-toggle')) {
    button.addEventListener('click', () => {
      const next = root.dataset.mode === 'dark' ? 'light' : 'dark'
      root.dataset.mode = next
      try {
        localStorage.setItem('theme', next)
      } catch {
        // Private mode or storage disabled: the switch still works for this visit.
      }
      sync()
    })
  }
  sync()
</script>

<style>
  .theme-toggle {
    /* Thumb and active icon colours; the open phone menu overrides them. */
    --switch-ink: var(--color-accent);
    --switch-on: var(--color-bg);
    position: relative;
    flex: none;
    display: inline-grid;
    /* Two 24px cells at the ends, the same size and spots as the thumb, so
       each icon sits dead centre in it on either side. */
    grid-template-columns: 24px 24px;
    justify-content: space-between;
    align-items: center;
    width: 64px;
    height: 32px;
    padding: 3px;
    background: none;
    border: 1px solid color-mix(in srgb, var(--switch-ink) 45%, transparent);
    border-radius: 999px;
    color: var(--switch-ink);
    cursor: pointer;
    transition: border-color .3s;
  }
  .theme-toggle:hover { border-color: var(--switch-ink); }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--switch-ink);
    outline-offset: 3px;
  }
  .thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--switch-ink);
    transition: transform .35s var(--ease-out), background-color .3s;
  }
  .icon {
    position: relative;
    display: block;
    justify-self: center;
    width: 15px;
    height: 15px;
    transition: color .3s, opacity .3s;
  }
  /* Day: thumb on the sun. Night: thumb slides right onto the cloud. */
  .sun { color: var(--switch-on); }
  .cloud { opacity: .6; }
  :global(html[data-mode="dark"]) .thumb { transform: translateX(32px); }
  :global(html[data-mode="dark"]) .sun {
    color: inherit;
    opacity: .6;
  }
  :global(html[data-mode="dark"]) .cloud {
    color: var(--switch-on);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb { transition: none; }
  }
</style>

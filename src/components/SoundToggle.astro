---
// Speaker switch for the station chime on page changes (scripts/chime.ts).
// Off by default; the choice is saved for the next visit.
---

<button type="button" class="sound-toggle" aria-label="Turn on station chime" aria-pressed="false" title="Station chime">
  <svg viewBox="0 0 24 24" aria-hidden="true" class="icon">
    <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
      <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"></path>
      <path class="waves" d="M15.5 9.2a4 4 0 0 1 0 5.6M18 6.8a7.4 7.4 0 0 1 0 10.4"></path>
      <path class="mute" d="M16 9.5l5 5M21 9.5l-5 5"></path>
    </g>
  </svg>
</button>

<script>
  import { chimeOn, playChime, setChime } from '../scripts/chime'

  const sync = () => {
    const on = chimeOn()
    for (const button of document.querySelectorAll('.sound-toggle')) {
      button.setAttribute('aria-pressed', String(on))
      button.setAttribute('aria-label', on ? 'Turn off station chime' : 'Turn on station chime')
    }
  }
  for (const button of document.querySelectorAll('.sound-toggle')) {
    button.addEventListener('click', () => {
      setChime(!chimeOn())
      sync()
      // Let the visitor hear what they switched on.
      playChime()
    })
  }
  sync()
</script>

<style>
  .sound-toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 50%;
    color: inherit;
    cursor: pointer;
    transition: color .3s, background-color .3s;
  }
  .sound-toggle:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  .icon {
    width: 19px;
    height: 19px;
  }
  .waves { display: none; }
  .sound-toggle[aria-pressed="true"] .waves { display: inline; }
  .sound-toggle[aria-pressed="true"] .mute { display: none; }
</style>

---
// The whole site, on one page: the hero, what I do, the work (each case
// opens in place), about and contact. All the copy comes from content/.
// Behind it, a three.js garden (scripts/garden): a flower opening behind
// the name, and leaves and petals drifting through the page.
import { getCollection, getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import { site } from '../site'

const page = (await getEntry('index', 'index'))!.data
const about = (await getEntry('about', 'about'))!.data
const projects = (await getCollection('projects'))
  .map(entry => entry.data)
  .sort((a, b) => a.order - b.order)

const skillByKey = new Map(page.skills.map(s => [s.key, s]))
const colorOf = (keys: string[]) => skillByKey.get(keys[0]!)?.color ?? '#fff3df'
const num = (i: number) => String(i + 1).padStart(2, '0')
const year = new Date().getFullYear()
---

<Base title={page.seo.title} description={page.seo.description}>
  <canvas id="garden" class="garden" aria-hidden="true"></canvas>
  <!-- three slightly different wobbles; the name cycles through them so its edges boil -->
  <svg class="defs" aria-hidden="true" focusable="false">
    {[3, 11, 23].map((seed, i) => (
      <filter id={`boil-${i}`}>
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed={seed} />
        <feDisplacementMap in="SourceGraphic" scale="5" />
      </filter>
    ))}
  </svg>
  <header class="top">
    <a href="#main" class="brand">{site.name}</a>
    <nav class="nav" aria-label="Sections">
      {site.nav.map(link => <a href={link.to} class="line-link">{link.label}</a>)}
    </nav>
    <a href={`mailto:${site.email}`} class="pill hire">Hire me</a>
  </header>

  <main id="main">
    <section class="hero wrap">
      <div class="hero-top">
        <p class="mono kicker">{page.role}</p>
        <p class="mono available"><span class="pulse" aria-hidden="true"></span>{page.available}</p>
      </div>
      <!-- the garden draws its flower behind this box; tap it to shake petals loose -->
      <div class="bloom" data-bloom>
        <h1 class="display name">
          <span>{page.name.split(' ')[0]}</span>
          <span>{page.name.split(' ').slice(1).join(' ')}</span>
        </h1>
        <p class="deva mr">{page.nameMr}</p>
      </div>
      <p class="intro">{page.intro}</p>
      <div class="actions">
        <a href="#work" class="pill">See the work</a>
        <a href={`mailto:${site.email}`} class="pill pill-warm">Write to me</a>
      </div>
      <ul class="stickers" aria-label="What I do">
        {page.skills.map((s, i) => (
          <li style={`--c: ${s.color}; --r: ${[-6, 4, -3, 7][i % 4]}deg`}>
            <a href={`#skill-${s.key}`} class="sticker">{s.title}</a>
          </li>
        ))}
      </ul>
      <ul class="stats">
        {page.stats.map(s => (
          <li><strong class="display">{s.value}</strong><span>{s.label}</span></li>
        ))}
      </ul>
    </section>

    <section id="skills" class="section wrap" aria-labelledby="skills-title">
      <h2 id="skills-title" class="display h2" data-reveal>What I do</h2>
      <ol class="grid skills">
        {page.skills.map((s, i) => {
          const used = projects.filter(p => p.skills.includes(s.key))
          return (
            <li id={`skill-${s.key}`} class="card skill" style={`--c: ${s.color}`} data-reveal={i * 80}>
              <p class="mono n">{num(i)}</p>
              <h3 class="card-title">{s.title}</h3>
              <p>{s.body}</p>
              <p class="mono used-label">Built with it</p>
              <ul class="chips">
                {used.map(p => <li><a href={`#p-${p.slug}`} class="chip" data-open>{p.title}</a></li>)}
              </ul>
            </li>
          )
        })}
      </ol>
    </section>

    <section id="work" class="section wrap" aria-labelledby="work-title">
      <div class="section-head">
        <h2 id="work-title" class="display h2" data-reveal>Work</h2>
        <p class="lede" data-reveal>{projects.length} things I’ve built since 2022, from SaaS backends to a sunspot model.</p>
      </div>
      <ol class="grid projects">
        {projects.map((p, i) => (
          <li class="project-cell">
            <article id={`p-${p.slug}`} class="card project" style={`--c: ${colorOf(p.skills)}`} data-reveal={(i % 2) * 80}>
              {p.image && <img class="shot" src={p.image} alt="" loading="lazy" decoding="async" width="1200" height="750">}
              {!p.image && p.confidential && <div class="shot nda"><span class="mono">Client work · under NDA</span></div>}
              <div class="project-body">
                <p class="mono n">{num(i)} · {p.type} · {p.year}</p>
                <h3 class="card-title">{p.title}</h3>
                <p class="metric"><strong class="display">{p.metric}</strong> <span class="mono">{p.metricLabel}</span></p>
                <p class="summary">{p.summary}</p>
                <ul class="tags">{p.tags.map(t => <li class="mono">{t}</li>)}</ul>
                <details class="case">
                  <summary class="pill pill-small"><span class="open-label">Read the case</span><span class="close-label">Close the case</span></summary>
                  <dl class="story">
                    <dt class="mono">Problem</dt><dd>{p.problem}</dd>
                    <dt class="mono">Build</dt><dd>{p.build}</dd>
                    <dt class="mono">Outcome</dt><dd>{p.outcome}</dd>
                  </dl>
                  {p.gallery && (
                    <div class="gallery">
                      {p.gallery.map(g => <img src={g.src} alt={g.alt} loading="lazy" decoding="async">)}
                    </div>
                  )}
                  <p class="case-links">
                    {p.link && <a href={p.link} class="line-link" target="_blank" rel="noopener">{p.linkLabel ?? 'Visit the live site'} ↗</a>}
                    {!p.link && p.repo && <a href={p.repo} class="line-link" target="_blank" rel="noopener">Available on GitHub ↗</a>}
                    {p.confidential && <span class="mono">Confidential client work</span>}
                  </p>
                </details>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section id="about" class="section wrap" aria-labelledby="about-title">
      <h2 id="about-title" class="display h2" data-reveal>About</h2>
      <div class="about">
        <div class="about-main">
          <p class="big" data-reveal>{about.profile}</p>
          <div class="facts" data-reveal>
            <div>
              <h3 class="mono">Stack</h3>
              <p>{about.stack}</p>
            </div>
            <div>
              <h3 class="mono">Recognition</h3>
              <ul>{about.recognition.map(r => <li>{r}</li>)}</ul>
            </div>
            <div>
              <h3 class="mono">Outside work</h3>
              <p>{about.outside}</p>
            </div>
          </div>
        </div>
        <div class="about-side">
          <div class="card" style="--c: var(--rust)" data-reveal>
            <h3 class="card-title">{about.approach.title}</h3>
            <p class="mono sub">{about.approach.subtitle}</p>
            <ol class="approach">
              {about.approach.items.map((a, i) => (
                <li><span class="mono n">{num(i)}</span><div><h4>{a.title}</h4><p>{a.body}</p></div></li>
              ))}
            </ol>
          </div>
          <div class="card" style="--c: var(--olive)" data-reveal>
            <h3 class="card-title">{about.experience.title}</h3>
            <ol class="jobs">
              {about.experience.items.map(j => (
                <li>
                  <p class="mono when">{j.when}</p>
                  <p class="org"><strong>{j.org}</strong> · {j.role}</p>
                  <p class="note">{j.note}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="section wrap contact" aria-labelledby="contact-title">
      <div class="contact-card" data-reveal>
        <h2 id="contact-title" class="display h2">{page.contact.title}</h2>
        <p class="big">{page.contact.body}</p>
        <a href={`mailto:${site.email}`} class="mail display">{site.email}</a>
        <ul class="socials">
          {site.socials.map(s => <li><a href={s.to} class="pill" target="_blank" rel="noopener">{s.label} ↗</a></li>)}
        </ul>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <p class="mono">© {year} {site.name} · <span class="deva">{page.nameMr}</span></p>
    <a href="#main" class="mono line-link">Back to top ↑</a>
  </footer>
</Base>

<script>
  import '../scripts/garden/stage'
  import '../scripts/open-case'
</script>

<style>
  /* ——— the garden, fixed behind the page ——— */
  .garden {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  :global(html.garden-ready) .garden { opacity: 1; }
  .defs { position: absolute; width: 0; height: 0; }
  main, .foot { position: relative; z-index: 1; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.garden-on) .name, :global(html.garden-on) .mr { animation: none; }
  }

  /* ——— header ——— */
  .top {
    position: sticky;
    top: var(--frame-top);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 14px var(--gutter);
    background: var(--color-bg);
    border-bottom: 2px solid var(--color-line);
  }
  .brand { font-weight: 800; font-size: 21px; font-variation-settings: var(--hand-loud); }
  .nav { display: flex; gap: 22px; margin-left: auto; font-weight: 600; }
  .hire { padding: 8px 16px; background: var(--marigold); }

  /* ——— hero ——— */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(22px, 4vh, 44px);
    padding-bottom: 28px;
  }
  .hero-top { align-self: stretch; }
  .hero-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .kicker { padding: 5px 12px; border-radius: 6px; background: var(--rust); color: var(--color-cream); }
  .available { display: inline-flex; align-items: center; gap: 10px; }
  .pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--olive);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--olive) 70%, transparent);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    to { box-shadow: 0 0 0 12px transparent; }
  }
  /* the flower is drawn behind this box. The name is plain white type with
     no outline; it reads as hand-drawn because its edges boil, cycling
     through three wobble filters a few times a second. */
  .bloom {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: clamp(20px, 5vh, 50px);
  }
  :global(html.garden-on) .bloom { min-height: clamp(440px, 66vh, 720px); cursor: pointer; }
  .name, .mr { position: relative; z-index: 1; pointer-events: none; }
  .name {
    font-family: var(--font-title);
    font-weight: 900;
    font-variation-settings: normal;
    font-size: clamp(54px, 9vw, 160px);
    line-height: .9;
    letter-spacing: -.01em;
    color: var(--color-ink);
  }
  .name span { display: inline-block; margin-inline: .1em; }
  .mr { margin-top: 12px; font-size: clamp(26px, 2.6vw, 38px); color: var(--color-ink); }
  :global(html.garden-on) .name,
  :global(html.garden-on) .mr { color: #fbf8f0; animation: boil .36s steps(1) infinite; }
  @keyframes boil {
    0% { filter: url(#boil-0); }
    33% { filter: url(#boil-1); }
    66% { filter: url(#boil-2); }
  }
  .intro { max-width: 50ch; font-size: clamp(17px, 1.5vw, 21px); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 22px; }
  .pill-warm { background: var(--marigold); }
  .sticker, .hire, .kicker { white-space: nowrap; }

  .stickers { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 10px; margin-top: 36px; }
  .sticker {
    display: inline-block;
    padding: 12px 20px 14px;
    border: 2.5px solid var(--color-ink);
    border-radius: 16px;
    background: var(--c);
    color: var(--color-ink);
    font-weight: 800;
    font-size: clamp(18px, 1.7vw, 24px);
    font-variation-settings: var(--hand-loud);
    box-shadow: 4px 4px 0 var(--color-ink);
    transform: rotate(var(--r));
    transition: transform .4s var(--ease-spring), box-shadow .4s var(--ease-spring);
  }
  .sticker:hover { transform: rotate(0) translateY(-6px) scale(1.05); box-shadow: 6px 10px 0 var(--color-ink); }

  .stats {
    align-self: stretch;
    text-align: left;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(30px, 5vh, 56px);
    border-top: 2px solid var(--color-line);
  }
  .stats li { display: grid; gap: 4px; padding: 18px 18px 0 0; }
  .stats li + li { padding-left: 18px; border-left: 2px solid var(--color-line); }
  .stats strong { font-size: clamp(30px, 3.2vw, 48px); color: var(--color-ink); }
  .stats span { font-size: 14px; color: var(--color-muted); max-width: 24ch; }

  /* ——— sections ——— */
  .section { padding-top: var(--section-y); scroll-margin-top: 40px; }
  .h2 { font-size: clamp(56px, 9vw, 130px); color: var(--color-ink); }
  .section-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px 40px; }
  .lede { max-width: 40ch; font-size: 19px; color: var(--color-muted); padding-bottom: 8px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; margin-top: 40px; }

  .card {
    position: relative;
    container-type: inline-size;
    padding: clamp(20px, 2.4vw, 32px);
    border: 2.5px solid var(--color-ink);
    border-radius: 22px;
    background: var(--color-cream);
    color: var(--color-ink);
    box-shadow: 8px 8px 0 var(--c, var(--color-ink));
    transition: transform .35s var(--ease-spring), box-shadow .35s var(--ease-spring);
  }
  .card:hover { transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--c, var(--color-ink)); }
  .card:target { animation: ping .9s var(--ease-out); }
  @keyframes ping {
    30% { transform: scale(1.02); }
  }
  .card-title { font-weight: 800; font-size: clamp(26px, 2.6vw, 38px); line-height: 1.05; font-variation-settings: var(--hand-loud); }
  .card p { line-height: 1.5; }
  .card .n { color: color-mix(in srgb, var(--color-ink) 60%, transparent); margin-bottom: 8px; }

  .skill { scroll-margin-top: 100px; }
  .skill .n { display: inline-block; padding: 4px 10px; border-radius: 6px; background: var(--c); color: var(--color-ink); }
  .skill > p:not(.mono) { margin-top: 12px; }
  .used-label { margin-top: 18px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .chip {
    display: inline-block;
    padding: 5px 12px;
    border: 2px solid var(--color-ink);
    border-radius: 999px;
    background: var(--color-cream);
    font-weight: 600;
    font-size: 14px;
    transition: background-color .2s, color .2s;
  }
  .chip:hover { background: var(--color-ink); color: var(--color-cream); }

  .projects { align-items: start; }
  /* an open case takes the full row */
  .project-cell:has(details[open]) { grid-column: 1 / -1; }
  .project-cell:has(details[open]) .shot { max-height: 440px; }
  .project { padding: 0; overflow: hidden; scroll-margin-top: 90px; }
  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 2.5px solid var(--color-ink);
  }
  .nda {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(-45deg, var(--color-ink) 0 14px, color-mix(in srgb, var(--color-ink) 85%, var(--c)) 14px 28px);
    color: var(--color-cream);
  }
  .project-body { padding: 22px clamp(20px, 2.4vw, 30px) 26px; }
  .metric { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 14px; }
  .metric strong { font-size: min(40px, 9cqw); line-height: 1.2; white-space: nowrap; color: var(--color-ink); background: var(--c); padding: 6px 12px 8px; border-radius: 10px; }
  .summary { margin-top: 14px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .tags li { padding: 4px 10px; border: 1.5px solid var(--color-ink); border-radius: 6px; font-size: 11px; line-height: 1.3; white-space: nowrap; }
  .case { margin-top: 18px; }
  .case summary { list-style: none; cursor: pointer; }
  .case summary::-webkit-details-marker { display: none; }
  .pill-small { padding: 7px 14px; font-size: 15px; background: var(--c); }
  .close-label, .case[open] .open-label { display: none; }
  .case[open] .close-label { display: inline; }
  /* open: the button inverts. Closed it is the card's colour with an ink edge and
     shadow; open it is ink with the card's colour as edge and shadow. */
  .case[open] summary { background: var(--color-ink); color: var(--color-cream); border-color: var(--c); box-shadow: 3px 3px 0 var(--c); }
  .case[open] summary:hover { box-shadow: 5px 5px 0 var(--c); }
  .case[open] summary:active { box-shadow: 1px 1px 0 var(--c); }
  .story { display: grid; grid-template-columns: 110px minmax(0, 62ch); gap: 12px 16px; margin-top: 22px; }
  .story dt { padding-top: 4px; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin-top: 22px; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 2px solid var(--color-ink); border-radius: 10px; }
  .case-links { margin-top: 18px; font-weight: 700; }

  .about { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 40px; margin-top: 40px; align-items: start; }
  .about-main { display: grid; gap: 36px; }
  .about-side { display: grid; gap: 28px; }
  .big { font-size: clamp(20px, 2vw, 28px); line-height: 1.4; font-weight: 500; }
  .sub { margin-top: 6px; }
  .approach { display: grid; gap: 16px; margin-top: 20px; }
  .approach li { display: grid; grid-template-columns: 2.4em 1fr; gap: 10px; }
  .approach h4 { font-size: 19px; font-weight: 800; }
  .approach .n { padding-top: 4px; }
  .jobs { display: grid; margin-top: 14px; }
  .jobs li { padding: 14px 0; border-top: 2px dashed color-mix(in srgb, var(--color-ink) 30%, transparent); }
  .jobs li:first-child { border-top: 0; }
  .org { font-size: 18px; margin-top: 2px; }
  .note { margin-top: 4px; color: color-mix(in srgb, var(--color-ink) 75%, transparent); }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 26px; }
  .facts h3 { color: var(--rust); margin-bottom: 8px; }
  .facts ul { display: grid; gap: 6px; }

  .contact-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    container-type: inline-size;
    gap: 26px;
    padding: clamp(28px, 5vw, 70px);
    border: 2.5px solid var(--color-ink);
    border-radius: 28px;
    background: var(--marigold);
    color: var(--color-ink);
    box-shadow: 10px 10px 0 var(--color-ink);
  }
  /* sized to the card, so the longest word always fits and nothing splits */
  .contact .h2 { color: var(--color-ink); font-size: min(130px, 15cqw); }
  .contact .big { max-width: 46ch; }
  .mail {
    justify-self: start;
    font-size: min(76px, 5.6cqw);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: max(2px, .07em);
    text-underline-offset: .14em;
    transition: color .2s;
  }
  .mail:hover { color: var(--rust); }
  .socials { display: flex; flex-wrap: wrap; gap: 12px; }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 60px 28px;
    color: var(--color-muted);
  }

  @media (max-width: 960px) {
    .about { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats li:nth-child(3) { padding-left: 0; border-left: 0; }
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .nav { display: none; }
    .hire { margin-left: auto; }
    :global(html.garden-on) .bloom { min-height: 380px; }
    .story { grid-template-columns: 1fr; gap: 4px; }
    .story dd { margin-bottom: 10px; }
    .card:hover { transform: none; box-shadow: 8px 8px 0 var(--c, var(--color-ink)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse { animation: none; }
  }
</style>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "richie-patil-portfolio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "richiepatil.com", "custom_domain": true },
    { "pattern": "www.richiepatil.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}

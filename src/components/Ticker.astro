---
// The Start page's availability line as a dot-matrix LED board, like the
// train indicators at Mumbai local stations: a black board, a grid of dim
// LEDs, and the phrases lighting up as they step left one LED column at a
// time (scripts/led-board.ts draws it on a canvas, so every script, Hindi
// and Arabic included, comes out in dots). Without JS, or before the board
// is ready, the same phrases scroll as plain text.
interface Props {
  phrases: { lang: string, text: string }[]
}
const { phrases } = Astro.props
const label = phrases[0]!.text
// Marathi is left untagged: Eczar's Marathi forms split र् into a half-र.
const langOf = (lang: string) => (lang === 'mr' ? undefined : lang)
const copies = phrases.length < 6 ? 4 : 2
const items = Array.from({ length: copies }, () => phrases).flat()
const seconds = Math.round(items.length / 2 * 9)
---

<div class="ticker" role="marquee" aria-label={label} data-led={JSON.stringify(phrases)}>
  <canvas class="led" aria-hidden="true"></canvas>
  <div class="track" aria-hidden="true" style={`--duration: ${seconds}s`}>
    {items.map(p => (
      <span class="phrase" lang={langOf(p.lang)} dir="auto">{p.text}</span>
      <span class="sep">✶</span>
    ))}
  </div>
</div>

<script>
  import '../scripts/led-board'
</script>

<style>
  .ticker {
    overflow: hidden;
    background: var(--color-band);
    color: var(--color-on-band);
    padding-block: 11px;
    transition: background-color .5s ease, color .5s ease;
  }
  .led { display: none; }

  /* — LED board, once led-board.ts has drawn it — */
  .ticker:global(.is-led) {
    display: flex;
    justify-content: center;
    padding: 7px 10px;
    background: var(--color-board);
  }
  .ticker:global(.is-led) .track { display: none; }
  .ticker:global(.is-led) .led {
    display: block;
    /* Just a breath of LED bleed. */
    filter: drop-shadow(0 0 1px color-mix(in srgb, var(--color-led) 55%, transparent));
  }

  /* — plain text fallback — */
  .track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: scroll var(--duration, 100s) linear infinite;
  }
  .phrase {
    font-size: 14px;
    line-height: 1.4;
    white-space: nowrap;
    unicode-bidi: isolate;
  }
  .phrase:lang(hi), .phrase:not([lang]) { font-family: var(--font-deva); }
  .sep {
    padding-inline: 2.4em;
    font-size: 10px;
    opacity: .55;
  }
  .ticker:hover .track { animation-play-state: paused; }
  @keyframes scroll {
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
  }
</style>

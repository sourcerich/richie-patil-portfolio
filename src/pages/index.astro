---
import { getCollection, getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import { site } from '../site'

const page = (await getEntry('index', 'index'))!.data
const about = (await getEntry('about', 'about'))!.data
const projects = (await getCollection('projects'))
  .map(entry => entry.data)
  .sort((a, b) => a.order - b.order)

const skillByKey = new Map(page.skills.map(s => [s.key, s]))
const colorOf = (keys: string[]) => skillByKey.get(keys[0]!)?.color ?? '#fff3df'
const num = (i: number) => String(i + 1).padStart(2, '0')
const words = (text: string) => text.split(' ')
const highlight = (text: string) => text
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/\*([^*]+)\*/g, '<mark>$1</mark>')
---

<Base title={page.seo.title} description={page.seo.description}>
  <main id="main">
    <section class="hero wrap">
      <div class="fold">
        <div class="bloom" data-bloom>
          <h1 class="deva mr" aria-label={page.name}>
            {words(page.nameMr).map((word, i) => <span class="ch" data-engine-word data-single data-alt={page.name.split(' ')[i]} aria-hidden="true">{word}</span>)}
          </h1>
        </div>
      </div>
    </section>

    <section id="skills" class="section wrap" aria-labelledby="skills-title">
      <h2 id="skills-title" class="display h2" data-reveal>What I do</h2>
      <ol class="rows skills">
        {page.skills.map((s, i) => (
          <li id={`skill-${s.key}`} class="row skill" style={`--c: ${s.color}`} data-reveal={i * 80}>
            <h3 class="row-title">{s.title}</h3>
            <div class="row-body">
              <p class="lead">{s.body}</p>
              <p class="mono used-label">What I cover</p>
              <ul class="chips">
                {s.tools.map(tool => <li>{tool}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="about" class="section wrap" aria-labelledby="about-title">
      <h2 id="about-title" class="display h2" data-reveal>About</h2>
      <p class="big about" data-reveal set:html={highlight(about.profile)} />
      <dl class="about-facts" data-reveal>
        {about.facts.map(f => <div><dt class="mono">{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
      <p class="ps" data-reveal>{about.ps}</p>
      <h3 class="step-head" data-reveal>{about.approach.title}</h3>
      <p class="mono sub" data-reveal>{about.approach.subtitle}</p>
      <ol class="steps">
        {about.approach.items.map((a, i) => (
          <li data-reveal={i * 80}>
            <span class="mono n">{num(i)}</span>
            <h3 class="step-title">{a.title}</h3>
            <p>{a.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="work" class="section wrap" aria-labelledby="work-title">
      <div class="section-head">
        <h2 id="work-title" class="display h2" data-reveal>Work</h2>
        <p class="lede" data-reveal>Chosen projects</p>
      </div>
      <ul class="work-grid">
        {projects.map((p, i) => (
          <li class="work-cell" style={`--c: ${colorOf(p.skills)}`} data-reveal={(i % 3) * 80}>
            <button type="button" class="tile" data-work={p.slug} aria-haspopup="dialog">
              {p.image
                ? <span class="frame"><img class="shot" src={p.image} alt="" loading="lazy" decoding="async" width="1200" height="900"></span>
                : <span class="frame"><span class="shot nda"><span class="mono">Client work · under NDA</span></span></span>}
              <span class="tile-meta">
                <span class="mono n">{p.type} · {p.year}</span>
                <span class="tile-title">{p.title}</span>
                <span class="tile-metric"><strong>{p.metric}</strong></span>
              </span>
            </button>
            <dialog id={`p-${p.slug}`} class="work-dialog" data-lenis-prevent aria-labelledby={`t-${p.slug}`} style={`--c: ${colorOf(p.skills)}`}>
              <div class="sheet">
                <button type="button" class="close mono" data-close>Close ✕</button>
                {p.image && <span class="frame"><img class="shot-large" src={p.image} alt="" loading="lazy" decoding="async" width="1200" height="750"></span>}
                <p class="mono n">{num(i)} · {p.type} · {p.year}</p>
                <h3 id={`t-${p.slug}`} class="row-title">{p.title}</h3>
                <p class="metric"><strong class="display">{p.metric}</strong> <span class="mono">{p.metricLabel}</span></p>
                <p class="summary">{p.summary}</p>
                <ul class="tags">{p.tags.map(t => <li class="mono">{t}</li>)}</ul>
                <dl class="story">
                  <dt class="mono">The problem</dt><dd>{p.problem}</dd>
                  <dt class="mono">What I built</dt><dd>{p.build}</dd>
                  <dt class="mono">The result</dt><dd>{p.outcome}</dd>
                </dl>
                {p.gallery && (
                  <div class="gallery">
                    {p.gallery.map(g => <span class="frame"><img src={g.src} alt={g.alt} loading="lazy" decoding="async"></span>)}
                  </div>
                )}
                <p class="case-links">
                  {p.link && <a href={p.link} class="line-link" target="_blank" rel="noopener">{p.linkLabel ?? 'See it live'} ↗</a>}
                  {!p.link && p.repo && <a href={p.repo} class="line-link" target="_blank" rel="noopener">View the code ↗</a>}
                  {p.confidential && <span class="mono">Confidential client work</span>}
                </p>
              </div>
            </dialog>
          </li>
        ))}
      </ul>
    </section>

    <section id="contact" class="section wrap contact" aria-labelledby="contact-title">
      <div class="contact-block" id="contact-card" data-reveal>
        <h2 id="contact-title" class="display h2">{page.contact.title}</h2>
        <p class="big">{page.contact.body}</p>
        <a href={`mailto:${site.email}`} class="mail display">{site.email}</a>
        <ul class="socials">
          {site.socials.map(s => <li><a href={s.to} class="pill" target="_blank" rel="noopener">{s.label} ↗</a></li>)}
        </ul>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <a href="#main" class="mono line-link">Back to top ↑</a>
  </footer>
</Base>

<script>
  import '../scripts/open-case'
</script>

<style>

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 0;
    padding-bottom: 1.75rem;
  }
  .bloom {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: clamp(1.25rem, 5vh, 3.125rem);
  }
  .fold {
    align-self: stretch;
    min-height: calc(100svh - var(--frame-w) * 2);
    min-height: 100cqh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .mr { position: relative; z-index: 1; pointer-events: none; color: #fff; }
  .ch { display: inline-block; }
  .mr { display: flex; flex-wrap: wrap; justify-content: center; column-gap: 0.4em; max-width: 100%; }
  :global(html.engine-text) .ch { color: transparent; }
  .mr { font-size: clamp(4.5rem, 15vw, 13rem); line-height: 1.1; }
  .row::before, .steps li::before, .foot::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    border-top: 0.1875rem solid var(--color-outline);
    border-radius: 62.4375rem;
  }

  .section { padding-top: var(--section-y); scroll-margin-top: 2.5rem; }
  .h2 {
    position: relative;
    display: inline-block;
    font-size: clamp(3rem, 9vw, 8.5rem);
    color: var(--color-ink);
  }
  .section-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.75rem 2.5rem; }
  .lede { max-width: 26rem; font-size: 1.1875rem; font-weight: 600; padding-bottom: 0.75rem; }

  .rows { display: grid; margin-top: 2.5rem; }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 1rem clamp(1.5rem, 5vw, 6rem);
    align-items: start;
    padding-block: clamp(1.75rem, 4vw, 3.25rem);
    scroll-margin-top: 10rem;
  }
  .row:target { animation: ping .9s var(--ease-out); }
  @keyframes ping {
    30% { transform: translateX(0.5rem); }
  }
  .row-title {
    font-weight: 800;
    font-size: clamp(2.25rem, 5vw, 4.75rem);
    line-height: 1;
    font-variation-settings: var(--hand-loud);
    text-decoration: underline;
    text-decoration-color: var(--c, var(--color-outline));
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.12em;
  }
  .row p { line-height: 1.55; }
  .lead { font-size: clamp(1.1875rem, 1.7vw, 1.625rem); font-weight: 600; line-height: 1.45; max-width: 52ch; }
  .used-label { margin-top: 1.5rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.375rem 0; margin-top: 0.625rem; font-size: 1.0625rem; font-weight: 600; }
  .chips li:not(:last-child)::after { content: '·'; margin-inline: 0.75rem; color: var(--color-outline); }

  .work-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.75rem, 3.5vw, 3.5rem) clamp(1.25rem, 2.5vw, 2.5rem); margin-top: 2.5rem; }
  .work-cell { min-width: 0; }
  .tile { display: grid; gap: 1rem; width: 100%; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: inherit;
  }
  .frame {
    position: relative;
    display: block;
    border-radius: 1.25rem;
    margin: 0.25rem;
    transition: transform .45s var(--ease-spring);
  }
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 0.1875rem solid var(--color-outline);
    border-radius: inherit;
    pointer-events: none;
    animation: wobble 0.54s steps(1) infinite;
  }
  .tile:hover .frame, .tile:focus-visible .frame { transform: translateY(-0.375rem) rotate(-0.6deg); }
  .nda {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(-45deg, var(--color-outline) 0 0.875rem, color-mix(in srgb, var(--color-outline) 85%, var(--c)) 0.875rem 1.75rem);
    color: var(--color-cream);
  }
  .tile-meta { display: grid; gap: 0.25rem; }
  .tile-meta .n { color: color-mix(in srgb, var(--color-ink) 70%, transparent); }
  .tile-title {
    font-weight: 800;
    font-size: clamp(1.5rem, 2.2vw, 2.125rem);
    line-height: 1.05;
    font-variation-settings: var(--hand-loud);
    text-decoration: underline;
    text-decoration-color: var(--c);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.14em;
    min-height: 2.1em;
    transition: text-decoration-thickness .3s var(--ease-out);
  }
  .tile:hover .tile-title, .tile:focus-visible .tile-title { text-decoration-thickness: 0.3em; }
  .tile-metric { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.125rem 0.625rem; }
  .tile-metric strong { color: var(--rust); font-size: 1.5rem; font-weight: 800; line-height: 1.1; }

  .work-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(0.75rem, 4vw, 3rem);
    border: 0;
    background: transparent;
    color: var(--color-ink);
    overflow-y: auto;
  }
  .work-dialog:not([open]) { display: none; }
  .work-dialog::backdrop { background: color-mix(in srgb, #fff 86%, transparent); backdrop-filter: blur(0.75rem); }
  .sheet {
    position: relative;
    display: grid;
    gap: 0.75rem;
    width: min(64rem, 100%);
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 3rem);
    background: var(--color-cream);
  }
  .close { justify-self: end; padding: 0.5rem 0; border: 0; background: none; color: var(--color-ink); font: inherit; cursor: pointer; }
  .shot-large {
    width: 100%;
    height: auto;
    display: block;
    border-radius: inherit;
  }
  .sheet .n { color: color-mix(in srgb, var(--color-ink) 70%, transparent); }
  .metric { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.375rem 0.875rem; }
  .metric strong { font-size: clamp(2.25rem, 5vw, 3.5rem); line-height: 1.05; white-space: nowrap; color: var(--rust); }
  .summary { font-size: 1.1875rem; font-weight: 600; max-width: 52ch; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.25rem 0; }
  .tags li { font-size: 0.8125rem; line-height: 1.3; white-space: nowrap; }
  .tags li:not(:last-child)::after { content: '·'; margin-inline: 0.5rem; }
  .story { display: grid; grid-template-columns: 6.875rem minmax(0, 68ch); gap: 0.75rem 1rem; margin-top: 0.75rem; }
  .story dt { padding-top: 0.25rem; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; align-items: start; margin-top: 0.75rem; }
  .gallery img { display: block; width: 100%; height: auto; border-radius: inherit; }
  .case-links { margin-top: 0.75rem; font-weight: 700; }

  .about { margin-top: 2.5rem; max-width: 58ch; }
  .about :global(mark) {
    background: none;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--rust);
    text-decoration-thickness: 0.16em;
    text-underline-offset: 0.14em;
  }
  .about-facts { display: grid; grid-template-columns: repeat(3, minmax(0, max-content)); justify-content: start; gap: 1rem 3rem; margin-top: 2rem; }
  .about-facts dt { color: var(--color-muted); }
  .about-facts dd { margin-top: 0.25rem; font-weight: 800; font-size: 1.1875rem; }
  .ps { margin-top: 1.75rem; max-width: 46ch; font-size: 1.0625rem; font-weight: 600; color: var(--color-muted); }
  .big { font-size: clamp(1.25rem, 2.1vw, 2rem); line-height: 1.4; font-weight: 600; }
  .sub { margin-top: 0.375rem; }
  .step-head { margin-top: clamp(3rem, 7vw, 5.5rem); font-weight: 800; font-size: clamp(2rem, 4.5vw, 3.75rem); line-height: 1; font-variation-settings: var(--hand-loud); }
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 4rem); margin-top: 1.75rem; }
  .steps li { position: relative; display: grid; align-content: start; gap: 0.5rem; padding-top: 1.5rem; }
  .steps .n { color: var(--rust); }
  .step-title { font-weight: 800; font-size: clamp(1.75rem, 3vw, 2.75rem); line-height: 1.05; font-variation-settings: var(--hand-loud); }
  .steps p { font-size: 1.125rem; font-weight: 600; line-height: 1.5; max-width: 38ch; }

  .contact-block {
    scroll-margin-top: 6.25rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    container-type: inline-size;
    gap: 1.625rem;
  }
  .contact { display: flex; flex-direction: column; justify-content: flex-end; min-height: calc(100cqh + var(--frame-w) - 6.5rem); }
  .contact .h2 { font-size: min(11rem, 17cqw); }
  @media (min-width: 48rem) {
    .contact .h2 { font-size: min(11rem, 8cqw); white-space: nowrap; }
    .contact .mail { font-size: min(5.5rem, 5.6cqw); }
  }
  .contact .big { max-width: 46ch; }
  .mail {
    justify-self: start;
    max-width: 100%;
    font-size: min(5.5rem, 7.2cqw);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--marigold);
    text-decoration-thickness: max(0.25rem, .1em);
    text-underline-offset: .14em;
    transition: color .2s;
  }
  .mail:hover { color: var(--rust); }
  .socials { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; }
  .socials .pill { font-size: 1.25rem; }

  .foot {
    position: relative;
    display: flex;
    justify-content: flex-end;
    margin-top: 4.5rem;
    padding-block: 1.5rem 1rem;
  }

  @media (max-width: 60rem) {
    .row { grid-template-columns: minmax(0, 1fr); }
    .work-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .steps { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 40rem) {
    .mr { font-size: min(6.5rem, 21vw); }
    .about-facts { grid-template-columns: minmax(0, 1fr); }
    .mail { font-size: 1.1875rem; padding-block: 0.625rem; }
    .story { grid-template-columns: 1fr; gap: 0.25rem; }
    .story dd { margin-bottom: 0.625rem; }
    .work-grid {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      margin-inline: -1.125rem;
      padding: 0 1.125rem 1rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1.125rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .work-grid::-webkit-scrollbar { display: none; }
    .work-cell { flex: 0 0 min(72vw, 22rem); scroll-snap-align: start; }
    .gallery { grid-template-columns: minmax(0, 1fr); }
    .case-links { overflow-wrap: anywhere; }
  }
</style>

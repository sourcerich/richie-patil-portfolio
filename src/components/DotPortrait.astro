---
// The About portrait as a field of small, equal dots on a canvas. Every
// dot is the same size; the picture comes only from each dot's shade, in
// copper for the person and a quiet grey for the backdrop. Under the cursor
// (or a finger) the dots near it show the photo's real colours.
//
// Data comes from tools/dot-portrait.py: portrait/tone.png (how light each
// dot is) and portrait/color.png (the photo's colour, alpha = how much of
// the person is in that cell). Colours follow the theme tokens, so it
// redraws when day/night switches.
---

<figure class="dot-portrait" role="img" aria-label="Portrait of Richie Patil, drawn in dots">
  <canvas aria-hidden="true"></canvas>
  <noscript><img src="/richie.jpg" alt="" width="600" height="600"></noscript>
</figure>

<script>
  type RGB = [number, number, number]

  const DOT = 0.62 // dot diameter as a share of its cell
  const REVEAL_CELLS = 24 // radius of the colour reveal, in dots
  const EASE = 0.14 // how fast the reveal fades in and out per frame

  const hex = (value: string, fallback: RGB): RGB => {
    const m = value.trim().match(/^#([0-9a-f]{6})$/i)
    if (!m) return fallback
    const n = parseInt(m[1], 16)
    return [n >> 16, (n >> 8) & 255, n & 255]
  }
  const mix = (a: RGB, b: RGB, t: number): RGB => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t]

  const load = (src: string) => new Promise<ImageData>((resolve, reject) => {
    const img = new Image()
    img.onload = () => {
      const c = document.createElement('canvas')
      c.width = img.width
      c.height = img.height
      const ctx = c.getContext('2d', { willReadFrequently: true })!
      ctx.drawImage(img, 0, 0)
      resolve(ctx.getImageData(0, 0, img.width, img.height))
    }
    img.onerror = reject
    img.src = src
  })

  const start = async (figure: HTMLElement) => {
    const canvas = figure.querySelector('canvas')!
    const ctx = canvas.getContext('2d')!
    const [tone, color] = await Promise.all([load('/portrait/tone.png'), load('/portrait/color.png')])
    const n = tone.width
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Per-dot shade colour for the current theme, recomputed on theme change.
    let base: RGB[] = []
    const shade = () => {
      const css = getComputedStyle(document.documentElement)
      const dark = document.documentElement.dataset.mode === 'dark'
      const bg = hex(css.getPropertyValue('--color-bg'), dark ? [26, 20, 17] : [243, 235, 214])
      const accent = hex(css.getPropertyValue('--color-accent'), dark ? [240, 144, 95] : [20, 18, 13])
      // Deep black by day, pale peach by night: the strongest shade.
      const strong = hex(css.getPropertyValue('--color-text'), dark ? [235, 179, 147] : [27, 25, 21])
      const faint = mix(bg, accent, 0.16)
      const grey = hex(css.getPropertyValue('--color-dot-grey'), dark ? [86, 80, 74] : [201, 192, 168])
      base = []
      for (let i = 0; i < n * n; i++) {
        const light = tone.data[i * 4] / 255
        const person = color.data[i * 4 + 3] / 255
        // Day: dark parts of the photo are the strongest shade. Night: the
        // light parts glow. Three stops (faint, copper, strong) so skin,
        // eyes and hair each get their own band.
        // By day the curve is steeper: skin is a mid-tone, and on light
        // paper it would otherwise come out as strong as the hair.
        const ink = dark ? light ** 0.85 : (1 - light) ** 1.9
        const figureDot = ink < 0.5 ? mix(faint, accent, ink * 2) : mix(accent, strong, (ink - 0.5) * 2)
        base.push(mix(grey, figureDot, person))
      }
    }

    let size = 0
    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      size = figure.clientWidth
      canvas.width = Math.round(size * dpr)
      canvas.height = Math.round(size * dpr)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    }

    // Pointer in dot coordinates, and how strongly the colour shows (0..1).
    const pointer = { x: 0, y: 0, inside: false }
    let strength = 0
    let frame = 0

    const draw = () => {
      ctx.clearRect(0, 0, size, size)
      const cell = size / n
      const r = (cell * DOT) / 2
      const r2 = REVEAL_CELLS * REVEAL_CELLS
      for (let y = 0; y < n; y++) {
        for (let x = 0; x < n; x++) {
          const i = y * n + x
          let c = base[i]
          if (strength > 0.001) {
            const dx = x - pointer.x
            const dy = y - pointer.y
            const d2 = dx * dx + dy * dy
            if (d2 < r2) {
              // Smooth falloff from the centre of the reveal to its edge.
              const t = 1 - d2 / r2
              const k = t * t * (3 - 2 * t) * strength
              const j = i * 4
              c = mix(c, [color.data[j], color.data[j + 1], color.data[j + 2]], k)
            }
          }
          ctx.fillStyle = `rgb(${c[0] | 0},${c[1] | 0},${c[2] | 0})`
          ctx.beginPath()
          ctx.arc((x + 0.5) * cell, (y + 0.5) * cell, r, 0, Math.PI * 2)
          ctx.fill()
        }
      }
    }

    const tick = () => {
      const target = pointer.inside ? 1 : 0
      strength = reduced ? target : strength + (target - strength) * EASE
      if (Math.abs(target - strength) < 0.002) strength = target
      draw()
      frame = strength === target ? 0 : requestAnimationFrame(tick)
    }
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(tick)
    }

    const move = (e: PointerEvent) => {
      const box = canvas.getBoundingClientRect()
      pointer.x = ((e.clientX - box.left) / box.width) * n - 0.5
      pointer.y = ((e.clientY - box.top) / box.height) * n - 0.5
      pointer.inside = true
      schedule()
    }
    canvas.addEventListener('pointermove', move)
    canvas.addEventListener('pointerdown', move)
    canvas.addEventListener('pointerleave', () => {
      pointer.inside = false
      schedule()
    })
    // Touch: let go and the colour fades back out.
    canvas.addEventListener('pointerup', (e) => {
      if (e.pointerType === 'touch') {
        pointer.inside = false
        schedule()
      }
    })

    new ResizeObserver(() => {
      resize()
      draw()
    }).observe(figure)
    new MutationObserver(() => {
      shade()
      draw()
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-mode'] })

    shade()
    resize()
    draw()
    figure.classList.add('ready')
  }

  for (const figure of document.querySelectorAll<HTMLElement>('.dot-portrait')) start(figure)
</script>

<style>
  .dot-portrait {
    position: relative;
    aspect-ratio: 1;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity .8s ease;
    cursor: crosshair;
    touch-action: pan-y;
  }
  .ready canvas { opacity: 1; }
  noscript img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

---
// The whole site, on one page: the hero, what I do, the work (each case
// opens in place), about and contact. All the copy comes from content/.
// Behind it, a three.js garden (scripts/garden): a flower opening behind
// the name, and leaves and petals drifting through the page.
import { getCollection, getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import { site } from '../site'

const page = (await getEntry('index', 'index'))!.data
const about = (await getEntry('about', 'about'))!.data
const projects = (await getCollection('projects'))
  .map(entry => entry.data)
  .sort((a, b) => a.order - b.order)

const skillByKey = new Map(page.skills.map(s => [s.key, s]))
const colorOf = (keys: string[]) => skillByKey.get(keys[0]!)?.color ?? '#fff3df'
const num = (i: number) => String(i + 1).padStart(2, '0')
const year = new Date().getFullYear()
---

<Base title={page.seo.title} description={page.seo.description}>
  <canvas id="garden" class="garden" aria-hidden="true"></canvas>
  <!-- three slightly different wobbles; the name cycles through them so its edges boil -->
  <svg class="defs" aria-hidden="true" focusable="false">
    {[3, 11, 23].map((seed, i) => (
      <filter id={`boil-${i}`}>
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed={seed} />
        <feDisplacementMap in="SourceGraphic" scale="5" />
      </filter>
    ))}
  </svg>
  <header class="top">
    <a href="#main" class="brand">{site.name}</a>
    <nav class="nav" aria-label="Sections">
      {site.nav.map(link => <a href={link.to} class="line-link">{link.label}</a>)}
    </nav>
    <a href="#contact-card" class="pill hire">Hire me</a>
  </header>

  <main id="main">
    <section class="hero wrap">
      <div class="hero-top">
        <p class="mono kicker">{page.role}</p>
        <p class="mono available"><span class="pulse" aria-hidden="true"></span>{page.available}</p>
      </div>
      <!-- the garden draws its flower behind this box; tap it to shake petals loose -->
      <div class="bloom" data-bloom>
        <h1 class="display name">
          <span>{page.name.split(' ')[0]}</span>
          <span>{page.name.split(' ').slice(1).join(' ')}</span>
        </h1>
        <p class="deva mr">{page.nameMr}</p>
      </div>
      <p class="intro">{page.intro}</p>
      <div class="actions">
        <a href="#work" class="pill">See the work</a>
        <a href={`mailto:${site.email}`} class="pill pill-warm">Write to me</a>
      </div>
      <ul class="stickers" aria-label="What I do">
        {page.skills.map((s, i) => (
          <li style={`--c: ${s.color}; --r: ${[-6, 4, -3, 7][i % 4]}deg`}>
            <a href={`#skill-${s.key}`} class="sticker">{s.title}</a>
          </li>
        ))}
      </ul>
      <ul class="stats">
        {page.stats.map(s => (
          <li><strong class="display">{s.value}</strong><span>{s.label}</span></li>
        ))}
      </ul>
    </section>

    <section id="skills" class="section wrap" aria-labelledby="skills-title">
      <h2 id="skills-title" class="display h2" data-reveal>What I do</h2>
      <ol class="grid skills">
        {page.skills.map((s, i) => {
          const used = projects.filter(p => p.skills.includes(s.key))
          return (
            <li id={`skill-${s.key}`} class="card skill" style={`--c: ${s.color}`} data-reveal={i * 80}>
              <p class="mono n">{num(i)}</p>
              <h3 class="card-title">{s.title}</h3>
              <p>{s.body}</p>
              <p class="mono used-label">Built with it</p>
              <ul class="chips">
                {used.map(p => <li><a href={`#p-${p.slug}`} class="chip" data-open>{p.title}</a></li>)}
              </ul>
            </li>
          )
        })}
      </ol>
    </section>

    <section id="work" class="section wrap" aria-labelledby="work-title">
      <div class="section-head">
        <h2 id="work-title" class="display h2" data-reveal>Work</h2>
        <p class="lede" data-reveal>{projects.length} things I’ve built since 2022, from SaaS backends to a sunspot model.</p>
      </div>
      <ol class="grid projects">
        {projects.map((p, i) => (
          <li class="project-cell">
            <article id={`p-${p.slug}`} class="card project" style={`--c: ${colorOf(p.skills)}`} data-reveal={(i % 2) * 80}>
              {p.image && <img class="shot" src={p.image} alt="" loading="lazy" decoding="async" width="1200" height="750">}
              {!p.image && p.confidential && <div class="shot nda"><span class="mono">Client work · under NDA</span></div>}
              <div class="project-body">
                <p class="mono n">{num(i)} · {p.type} · {p.year}</p>
                <h3 class="card-title">{p.title}</h3>
                <p class="metric"><strong class="display">{p.metric}</strong> <span class="mono">{p.metricLabel}</span></p>
                <p class="summary">{p.summary}</p>
                <ul class="tags">{p.tags.map(t => <li class="mono">{t}</li>)}</ul>
                <details class="case">
                  <summary class="pill pill-small"><span class="open-label">Read the case</span><span class="close-label">Close the case</span></summary>
                  <dl class="story">
                    <dt class="mono">Problem</dt><dd>{p.problem}</dd>
                    <dt class="mono">Build</dt><dd>{p.build}</dd>
                    <dt class="mono">Outcome</dt><dd>{p.outcome}</dd>
                  </dl>
                  {p.gallery && (
                    <div class="gallery">
                      {p.gallery.map(g => <img src={g.src} alt={g.alt} loading="lazy" decoding="async">)}
                    </div>
                  )}
                  <p class="case-links">
                    {p.link && <a href={p.link} class="line-link" target="_blank" rel="noopener">{p.linkLabel ?? 'Visit the live site'} ↗</a>}
                    {!p.link && p.repo && <a href={p.repo} class="line-link" target="_blank" rel="noopener">Available on GitHub ↗</a>}
                    {p.confidential && <span class="mono">Confidential client work</span>}
                  </p>
                </details>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section id="about" class="section wrap" aria-labelledby="about-title">
      <h2 id="about-title" class="display h2" data-reveal>About</h2>
      <div class="about">
        <div class="about-main">
          <p class="big" data-reveal>{about.profile}</p>
          <div class="facts" data-reveal>
            <div>
              <h3 class="mono">Stack</h3>
              <p>{about.stack}</p>
            </div>
            <div>
              <h3 class="mono">Recognition</h3>
              <ul>{about.recognition.map(r => <li>{r}</li>)}</ul>
            </div>
            <div>
              <h3 class="mono">Outside work</h3>
              <p>{about.outside}</p>
            </div>
          </div>
        </div>
        <div class="about-side">
          <div class="card" style="--c: var(--rust)" data-reveal>
            <h3 class="card-title">{about.approach.title}</h3>
            <p class="mono sub">{about.approach.subtitle}</p>
            <ol class="approach">
              {about.approach.items.map((a, i) => (
                <li><span class="mono n">{num(i)}</span><div><h4>{a.title}</h4><p>{a.body}</p></div></li>
              ))}
            </ol>
          </div>
          <div class="card" style="--c: var(--olive)" data-reveal>
            <h3 class="card-title">{about.experience.title}</h3>
            <ol class="jobs">
              {about.experience.items.map(j => (
                <li>
                  <p class="mono when">{j.when}</p>
                  <p class="org"><strong>{j.org}</strong> · {j.role}</p>
                  <p class="note">{j.note}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="section wrap contact" aria-labelledby="contact-title">
      <div class="contact-card" id="contact-card" data-reveal>
        <h2 id="contact-title" class="display h2">{page.contact.title}</h2>
        <p class="big">{page.contact.body}</p>
        <a href={`mailto:${site.email}`} class="mail display">{site.email}</a>
        <ul class="socials">
          {site.socials.map(s => <li><a href={s.to} class="pill" target="_blank" rel="noopener">{s.label} ↗</a></li>)}
        </ul>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <p class="mono">© {year} {site.name} · <span class="deva">{page.nameMr}</span></p>
    <a href="#main" class="mono line-link">Back to top ↑</a>
  </footer>
</Base>

<script>
  import '../scripts/garden/stage'
  import '../scripts/open-case'
</script>

<style>
  /* ——— the garden, fixed behind the page ——— */
  .garden {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  :global(html.garden-ready) .garden { opacity: 1; }
  .defs { position: absolute; width: 0; height: 0; }
  main, .foot { position: relative; z-index: 1; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.garden-on) .name, :global(html.garden-on) .mr { animation: none; }
  }

  /* ——— header ——— */
  .top {
    position: sticky;
    top: var(--frame-top);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding: 0.875rem var(--gutter) calc(0.875rem + 0.125rem);
    /* The header's paper is on a pseudo-element, not the header itself: Safari 26
       tints its status bar from the background of fixed/sticky elements near the
       top edge (but ignores pseudo-elements), and we want that to be the frame. */
    background: transparent;
  }
  .top::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-bg);
    border-bottom: 0.125rem solid var(--color-line);
    pointer-events: none;
  }
  .brand { font-weight: 800; font-size: 1.3125rem; font-variation-settings: var(--hand-loud); }
  .nav { display: flex; gap: 1.375rem; margin-left: auto; font-weight: 600; }
  .hire { padding: 0.5rem 1rem; background: var(--marigold); }

  /* ——— hero ——— */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: clamp(1.375rem, 4vh, 2.75rem);
    padding-bottom: 1.75rem;
  }
  .hero-top { align-self: stretch; }
  .hero-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem; }
  .kicker { padding: 0.3125rem 0.75rem; border-radius: 0.375rem; background: var(--rust); color: var(--color-cream); }
  .available { display: inline-flex; align-items: center; gap: 0.625rem; }
  .pulse {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--olive);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--olive) 70%, transparent);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    to { box-shadow: 0 0 0 0.75rem transparent; }
  }
  /* the flower is drawn behind this box. The name is plain white type with
     no outline; it reads as hand-drawn because its edges boil, cycling
     through three wobble filters a few times a second. */
  .bloom {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: clamp(1.25rem, 5vh, 3.125rem);
  }
  :global(html.garden-on) .bloom { min-height: clamp(27.5rem, 66vh, 45rem); cursor: pointer; }
  .name, .mr { position: relative; z-index: 1; pointer-events: none; }
  .name {
    font-family: var(--font-title);
    font-weight: 900;
    font-variation-settings: normal;
    font-size: clamp(3.375rem, 9vw, 10rem);
    line-height: .9;
    letter-spacing: -.01em;
    color: var(--color-ink);
  }
  .name span { display: inline-block; margin-inline: .1em; }
  .mr { margin-top: 0.75rem; font-size: clamp(1.625rem, 2.6vw, 2.375rem); color: var(--color-ink); }
  :global(html.garden-on) .name,
  :global(html.garden-on) .mr { color: #fbf8f0; animation: boil .36s steps(1) infinite; }
  @keyframes boil {
    0% { filter: url(#boil-0); }
    33% { filter: url(#boil-1); }
    66% { filter: url(#boil-2); }
  }
  .intro { max-width: 50ch; font-size: clamp(1.0625rem, 1.5vw, 1.3125rem); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.875rem; margin-top: 1.375rem; }
  .pill-warm { background: var(--marigold); }
  .sticker, .hire, .kicker { white-space: nowrap; }

  .stickers { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.875rem 0.625rem; margin-top: 2.25rem; }
  .sticker {
    display: inline-block;
    padding: 0.75rem 1.25rem 0.875rem;
    border: 0.15625rem solid var(--color-ink);
    border-radius: 1rem;
    background: var(--c);
    color: var(--color-ink);
    font-weight: 800;
    font-size: clamp(1.125rem, 1.7vw, 1.5rem);
    font-variation-settings: var(--hand-loud);
    box-shadow: 0.25rem 0.25rem 0 var(--color-ink);
    transform: rotate(var(--r));
    transition: transform .4s var(--ease-spring), box-shadow .4s var(--ease-spring);
  }
  .sticker:hover { transform: rotate(0) translateY(-0.375rem) scale(1.05); box-shadow: 0.375rem 0.625rem 0 var(--color-ink); }

  .stats {
    align-self: stretch;
    text-align: left;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(1.875rem, 5vh, 3.5rem);
    border-top: 0.125rem solid var(--color-line);
  }
  .stats li { display: grid; gap: 0.25rem; padding: 1.125rem 1.125rem 0 0; }
  .stats li + li { padding-left: 1.125rem; border-left: 0.125rem solid var(--color-line); }
  .stats strong { font-size: clamp(1.875rem, 3.2vw, 3rem); color: var(--color-ink); }
  .stats span { font-size: 0.875rem; color: var(--color-muted); max-width: 24ch; }

  /* ——— sections ——— */
  .section { padding-top: var(--section-y); scroll-margin-top: 2.5rem; }
  .h2 { font-size: clamp(3.5rem, 9vw, 8.125rem); color: var(--color-ink); }
  .section-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.75rem 2.5rem; }
  .lede { max-width: 40ch; font-size: 1.1875rem; color: var(--color-muted); padding-bottom: 0.5rem; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem; margin-top: 2.5rem; }

  .card {
    position: relative;
    container-type: inline-size;
    padding: clamp(1.25rem, 2.4vw, 2rem);
    border: 0.15625rem solid var(--color-ink);
    border-radius: 1.375rem;
    background: var(--color-cream);
    color: var(--color-ink);
    box-shadow: 0.5rem 0.5rem 0 var(--c, var(--color-ink));
    transition: transform .35s var(--ease-spring), box-shadow .35s var(--ease-spring);
  }
  .card:hover { transform: translate(-0.1875rem, -0.1875rem); box-shadow: 0.6875rem 0.6875rem 0 var(--c, var(--color-ink)); }
  .card:target { animation: ping .9s var(--ease-out); }
  @keyframes ping {
    30% { transform: scale(1.02); }
  }
  .card-title { font-weight: 800; font-size: clamp(1.625rem, 2.6vw, 2.375rem); line-height: 1.05; font-variation-settings: var(--hand-loud); }
  .card p { line-height: 1.5; }
  .card .n { color: color-mix(in srgb, var(--color-ink) 60%, transparent); margin-bottom: 0.5rem; }

  .skill { scroll-margin-top: 6.25rem; }
  .skill .n { display: inline-block; padding: 0.25rem 0.625rem; border-radius: 0.375rem; background: var(--c); color: var(--color-ink); }
  .skill > p:not(.mono) { margin-top: 0.75rem; }
  .used-label { margin-top: 1.125rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .chip {
    display: inline-block;
    padding: 0.3125rem 0.75rem;
    border: 0.125rem solid var(--color-ink);
    border-radius: 62.4375rem;
    background: var(--color-cream);
    font-weight: 600;
    font-size: 0.875rem;
    transition: background-color .2s, color .2s;
  }
  .chip:hover { background: var(--color-ink); color: var(--color-cream); }

  .projects { align-items: start; }
  /* an open case takes the full row */
  .project-cell:has(details[open]) { grid-column: 1 / -1; }
  .project-cell:has(details[open]) .shot { max-height: 27.5rem; }
  .project { padding: 0; overflow: hidden; scroll-margin-top: 5.625rem; }
  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 0.15625rem solid var(--color-ink);
  }
  .nda {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(-45deg, var(--color-ink) 0 0.875rem, color-mix(in srgb, var(--color-ink) 85%, var(--c)) 0.875rem 1.75rem);
    color: var(--color-cream);
  }
  .project-body { padding: 1.375rem clamp(1.25rem, 2.4vw, 1.875rem) 1.625rem; }
  .metric { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-top: 0.875rem; }
  .metric strong { font-size: min(2.5rem, 9cqw); line-height: 1.2; white-space: nowrap; color: var(--color-ink); background: var(--c); padding: 0.375rem 0.75rem 0.5rem; border-radius: 0.625rem; }
  .summary { margin-top: 0.875rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 1rem; }
  .tags li { padding: 0.25rem 0.625rem; border: 0.09375rem solid var(--color-ink); border-radius: 0.375rem; font-size: 0.6875rem; line-height: 1.3; white-space: nowrap; }
  .case { margin-top: 1.125rem; }
  .case summary { list-style: none; cursor: pointer; }
  .case summary::-webkit-details-marker { display: none; }
  .pill-small { padding: 0.4375rem 0.875rem; font-size: 0.9375rem; background: var(--c); }
  .close-label, .case[open] .open-label { display: none; }
  .case[open] .close-label { display: inline; }
  /* open: the button inverts. Closed it is the card's colour with an ink edge and
     shadow; open it is ink with the card's colour as edge and shadow. */
  .case[open] summary { background: var(--color-ink); color: var(--color-cream); border-color: var(--c); box-shadow: 0.1875rem 0.1875rem 0 var(--c); }
  .case[open] summary:hover { box-shadow: 0.3125rem 0.3125rem 0 var(--c); }
  .case[open] summary:active { box-shadow: 0.0625rem 0.0625rem 0 var(--c); }
  .story { display: grid; grid-template-columns: 6.875rem minmax(0, 62ch); gap: 0.75rem 1rem; margin-top: 1.375rem; }
  .story dt { padding-top: 0.25rem; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(13.75rem, 1fr)); gap: 0.75rem; margin-top: 1.375rem; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 0.125rem solid var(--color-ink); border-radius: 0.625rem; }
  .case-links { margin-top: 1.125rem; font-weight: 700; }

  .about { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2.5rem; margin-top: 2.5rem; align-items: start; }
  .about-main { display: grid; gap: 2.25rem; }
  .about-side { display: grid; gap: 1.75rem; }
  .big { font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.4; font-weight: 500; }
  .sub { margin-top: 0.375rem; }
  .approach { display: grid; gap: 1rem; margin-top: 1.25rem; }
  .approach li { display: grid; grid-template-columns: 2.4em 1fr; gap: 0.625rem; }
  .approach h4 { font-size: 1.1875rem; font-weight: 800; }
  .approach .n { padding-top: 0.25rem; }
  .jobs { display: grid; margin-top: 0.875rem; }
  .jobs li { padding: 0.875rem 0; border-top: 0.125rem dashed color-mix(in srgb, var(--color-ink) 30%, transparent); }
  .jobs li:first-child { border-top: 0; }
  .org { font-size: 1.125rem; margin-top: 0.125rem; }
  .note { margin-top: 0.25rem; color: color-mix(in srgb, var(--color-ink) 75%, transparent); }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(11.875rem, 1fr)); gap: 1.625rem; }
  .facts h3 { color: var(--rust); margin-bottom: 0.5rem; }
  .facts ul { display: grid; gap: 0.375rem; }

  .contact-card {
    scroll-margin-top: 6.25rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    container-type: inline-size;
    gap: 1.625rem;
    padding: clamp(1.75rem, 5vw, 4.375rem);
    border: 0.15625rem solid var(--color-ink);
    border-radius: 1.75rem;
    background: var(--marigold);
    color: var(--color-ink);
    box-shadow: 0.625rem 0.625rem 0 var(--color-ink);
  }
  /* sized to the card, so the longest word always fits and nothing splits */
  .contact .h2 { color: var(--color-ink); font-size: min(8.125rem, 15cqw); }
  .contact .big { max-width: 46ch; }
  .mail {
    justify-self: start;
    font-size: min(4.75rem, 5.6cqw);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: max(0.125rem, .07em);
    text-underline-offset: .14em;
    transition: color .2s;
  }
  .mail:hover { color: var(--rust); }
  .socials { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 3.75rem 1.75rem;
    color: var(--color-muted);
  }

  @media (max-width: 60rem) {
    .about { grid-template-columns: 1fr; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats li:nth-child(3) { padding-left: 0; border-left: 0; }
    .grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 40rem) {
    .nav { display: none; }
    .hire { margin-left: auto; }
    :global(html.garden-on) .bloom { min-height: 23.75rem; }
    .story { grid-template-columns: 1fr; gap: 0.25rem; }

---
// Switches the site between day (warm paper) and night (dark brown). The
// starting mode is set before first paint by the inline script in
// Base.astro; this saves the visitor's choice so it sticks across visits.
// Both icons are rendered and CSS shows the right one, so there is no flash.
---

<button type="button" class="theme-toggle" aria-label="Switch to dark mode" aria-pressed="false">
  <!-- Moon in day mode, sun at night: the icon shows where the switch goes. -->
  <svg viewBox="0 0 24 24" aria-hidden="true" class="icon moon">
    <path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
  </svg>
  <svg viewBox="0 0 24 24" aria-hidden="true" class="icon sun">
    <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
    </g>
  </svg>
</button>

<script>
  // Keep in sync with --color-bg in main.css and the inline script.
  const THEME_COLORS = { light: '#f3ebd6', dark: '#141311' }
  const root = document.documentElement

  const sync = () => {
    const dark = root.dataset.mode === 'dark'
    for (const button of document.querySelectorAll('.theme-toggle')) {
      button.setAttribute('aria-pressed', String(dark))
      button.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode')
    }
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', THEME_COLORS[dark ? 'dark' : 'light'])
  }

  for (const button of document.querySelectorAll('.theme-toggle')) {
    button.addEventListener('click', () => {
      const next = root.dataset.mode === 'dark' ? 'light' : 'dark'
      root.dataset.mode = next
      try {
        localStorage.setItem('theme', next)
      } catch {
        // Private mode or storage disabled: the switch still works for this visit.
      }
      sync()
    })
  }
  sync()
</script>

<style>
  .theme-toggle {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-right: -8px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 50%;
    color: inherit;
    cursor: pointer;
    transition: color .3s, background-color .3s;
  }
  .theme-toggle:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, currentColor 8%, transparent);
  }
  .icon {
    width: 19px;
    height: 19px;
  }
  .sun { display: none; }
  :global(html[data-mode="dark"]) .sun { display: block; }
  :global(html[data-mode="dark"]) .moon { display: none; }
</style>

---
import Base from '../layouts/Base.astro'
---

<Base title="Not found – Richie Patil" description="There’s nothing at this address.">
  <main id="main" class="wrap lost">
    <p class="mono">404</p>
    <h1 class="display">Nothing here.</h1>
    <a href="/" class="pill">Back to the graph</a>
  </main>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1.375rem;
  }
  .lost h1 { font-size: clamp(4rem, 12vw, 11.25rem); color: var(--rust); }
</style>

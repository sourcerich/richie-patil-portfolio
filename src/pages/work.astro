---
// Every project on one page, the way the reference lists its work: title,
// what it was, a Year / Stack / Type row and a link, beside a big image.
// Each project has an anchor (/work#<slug>) so it can be linked directly.
// On wider screens the list is pinned and scrolling down slides the
// projects sideways (scripts/horizontal-scroll.ts); once the last one is in
// view the page carries on down. Phones, reduced motion and no-JS get the
// plain vertical list.
import { getCollection, getEntry } from 'astro:content'
import Page from '../layouts/Page.astro'
import PageHead from '../components/PageHead.astro'
import ProjectPlate from '../components/ProjectPlate.astro'

const page = (await getEntry('work', 'work'))!.data
const projects = (await getCollection('projects'))
  .map(entry => entry.data)
  .sort((a, b) => a.order - b.order)

// The "Stack" fact is the project's first two tags.
const stackOf = (tags: string[]) => tags.slice(0, 2).join(', ')
const num = (i: number) => String(i + 1).padStart(2, '0')
---

<Page title={page.title} ogTitle={page.seo.title} description={page.seo.description}>
  <PageHead ghost={page.ghost} lines={[page.title]} subtitle={page.subtitle} />

  <section class="section reel" data-hscroll aria-label="Projects">
    <div class="viewport">
      <ol class="projects" data-hscroll-track>
    {projects.map((project, i) => (
      <li id={project.slug} class="project">
        <div data-reveal="0" class="text">
          <span class="tnum count" aria-label={`Project ${num(i)}`}>{num(i)}</span>
          <h2 class="title">{project.title}</h2>
          <p class="summary">{project.summary}</p>
          <details class="more">
            <summary>
              <span class="label">The story</span>
              <span class="plus" aria-hidden="true">+</span>
            </summary>
            <dl class="story">
              <dt>Problem</dt>
              <dd>{project.problem}</dd>
              <dt>Build</dt>
              <dd>{project.build}</dd>
              <dt>Outcome</dt>
              <dd>{project.outcome}</dd>
            </dl>
          </details>
          <dl class="facts">
            <div>
              <dt>Year</dt>
              <dd class="tnum">{project.year}</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>{stackOf(project.tags)}</dd>
            </div>
            <div>
              <dt>Type</dt>
              <dd>{project.type}</dd>
            </div>
          </dl>
          {project.link
            ? (
              <a href={project.link} target="_blank" rel="noopener" class="dot-link">
                <span class="ring" aria-hidden="true"></span>
                {(project.linkLabel ?? 'Visit the live site').replace(/\s*↗$/, '')}
              </a>
            )
            : project.repo
              ? (
                <a href={project.repo} target="_blank" rel="noopener" class="dot-link">
                  <span class="ring" aria-hidden="true"></span>
                  Available on GitHub
                </a>
              )
              : <span class="no-link">{project.confidential ? 'Client work, under NDA' : 'Not public'}</span>}
        </div>
        <figure data-reveal="120" class="plate">
          <ProjectPlate image={project.image} title={project.title} num={num(i)} confidential={project.confidential} />
        </figure>
      </li>
    ))}
      </ol>
      <div class="progress" aria-hidden="true"><span data-hscroll-bar></span></div>
    </div>
  </section>
</Page>

<script>
  import '../scripts/horizontal-scroll'
</script>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: clamp(100px, 12vw, 170px);
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: var(--gutter);
  }
  .progress { display: none; }

  /* — sideways reel, switched on by horizontal-scroll.ts — */
  .reel:global(.is-on) {
    padding-block: 0;
  }
  .reel:global(.is-on) .viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    /* clip, not hidden: the browser's own jump to /work#<slug> would
       otherwise scroll this box sideways as well as moving the track. */
    overflow: clip;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .reel:global(.is-on) .projects {
    position: relative;
    flex-direction: row;
    align-items: center;
    gap: clamp(160px, 15vw, 300px);
    width: max-content;
    max-width: none;
    margin: 0;
    /* Extra room before the first project and after the last. */
    padding-inline: calc(var(--gutter) + clamp(40px, 6vw, 120px));
    will-change: transform;
  }
  .reel:global(.is-on) .project {
    flex: none;
    width: min(1180px, 80vw);
    align-items: center;
  }
  .reel:global(.is-on) .plate { max-height: 72vh; }
  .reel:global(.is-on) .progress {
    display: block;
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(28px, 5vh, 48px);
    height: 1px;
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 40px clamp(48px, 9vw, 160px);
    align-items: start;
    scroll-margin-top: 40px;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* Project numbers as a BEST bus route plate, drawn quietly: a hairline
     box with the route number, "Route" in small caps beside it. */
  .count {
    display: inline-flex;
    align-items: center;
    gap: .55em;
    padding: .32em .6em .28em;
    border: 1px solid currentColor;
    border-radius: 3px;
    color: var(--color-accent);
    font-size: 13px;
    letter-spacing: .04em;
    line-height: 1;
  }
  .count::before {
    content: 'Route';
    font-size: .72em;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .title {
    margin-top: 10px;
    font-size: clamp(36px, 3.6vw, 52px);
    font-weight: 400;
    letter-spacing: -.035em;
    line-height: 1.02;
    color: var(--color-accent);
  }
  .summary {
    margin-top: 26px;
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.45;
  }
  .more {
    margin-top: 18px;
    width: 100%;
    max-width: 52ch;
  }
  .more summary {
    display: inline-flex;
    gap: 10px;
    align-items: baseline;
  }
  .plus {
    color: var(--color-accent);
    transition: transform .3s var(--ease-out);
  }
  .more[open] .plus { transform: rotate(45deg); }
  .story {
    margin-top: 16px;
    display: grid;
    grid-template-columns: 76px 1fr;
    gap: 12px 16px;
    font-size: 15px;
    line-height: 1.45;
  }
  .story dt { color: var(--color-accent); }
  .facts {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 52px;
  }
  .facts dt {
    font-size: 13px;
    color: var(--color-accent);
  }
  .facts dd { font-size: 16px; }
  .dot-link,
  .no-link { margin-top: 40px; }
  .no-link {
    font-size: 15px;
    color: var(--color-muted);
  }
  .plate {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .plate :global(img) {
    filter: saturate(1.15);
    transition: transform 1.2s var(--ease-out);
  }
  .project:hover .plate :global(img) { transform: scale(1.04); }

  @media (max-width: 860px) {
    .project { grid-template-columns: 1fr; }
    .plate { order: -1; }
  }
</style>

---
import '../styles/main.css'
import { site } from '../site'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const pageUrl = site.url + Astro.url.pathname
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#ecc168">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, noai, noimageai">
    <link rel="canonical" href={pageUrl}>
    <meta property="og:site_name" content={site.name}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={pageUrl}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={`${site.url}/richie.webp`}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content={`${site.url}/richie.webp`}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="preload" as="font" type="font/woff2" href="/fonts/shantell-sans-latin.woff2" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/nunito-latin.woff2" crossorigin>
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <svg class="defs" aria-hidden="true" focusable="false">
      {[3, 11, 23].map((seed, i) => (
        <filter id={`boil-${i}`} x="-10%" y="-10%" width="120%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed={seed} result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.6" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      ))}
      {[2, 13, 31].map((seed, i) => (
        <filter id={`wob-${i}`} x="-4%" y="-12%" width="108%" height="124%">
          <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed={seed} result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      ))}
      {[5, 17, 29].map((seed, i) => (
        <filter id={`type-${i}`} x="-2%" y="-10%" width="104%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed={seed} result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      ))}
    </svg>
    <iframe id="flower-bg" class="flower-bg" src="/scene.html" title="" aria-hidden="true" tabindex="-1"></iframe>
    <header class="top">
      <a href="#main" class="brand">{site.name}</a>
      <nav class="nav" aria-label="Sections">
        {site.nav.map(link => <a href={link.to} class="nav-link">{link.label}</a>)}
      </nav>
      <a href="#contact-card" class="hire line-link" aria-label="Write to me">
        <svg class="mail-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="2.5" y="4.5" width="19" height="15" rx="3" />
          <path d="M3.5 7.5 12 13.5 20.5 7.5" />
        </svg>
        <span class="hire-label">Write to me</span>
      </a>
    </header>
    <div class="scroller" id="scroller">
      <div class="blur-top" aria-hidden="true"></div>
      <div class="paper"><slot /></div>
    </div>
  </body>
</html>

<script>
  import '../scripts/safari-filters'
  import '../scripts/reset-scroll'
  import '../scripts/anchors'
  import '../scripts/smooth-scroll'
  import '../scripts/reveal'
  import '../scripts/keep-words'
  import '../scripts/flower-bg'
  import '../scripts/nav-spy'
</script>

<style>
  .flower-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }
  .top {
    position: fixed;
    inset: calc(var(--frame-w) * 0.66 + env(safe-area-inset-top, 0rem)) 0 auto 0;
    z-index: 20;
    height: auto;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding-inline: calc(var(--frame-w) + var(--gutter));
    color: var(--color-outline);
  }
  .brand { font-weight: 800; font-size: 1.3125rem; font-variation-settings: var(--hand-loud); }
  .nav {
    display: flex;
    gap: 0.25rem;
    margin-inline: auto;
    font-weight: 600;
  }
  .nav-link {
    position: relative;
    padding: 0.4375rem 1rem;
  }
  .nav-link :global(.nav-paint) {
    position: absolute;
    left: 0.25rem;
    top: 0.3125rem;
    width: calc(100% - 0.5rem);
    height: calc(100% - 0.625rem);
    overflow: visible;
    pointer-events: none;
    transition: opacity .25s;
  }
  .nav-link :global(.nav-paint text) {
    fill: #fff;
    text-anchor: middle;
    dominant-baseline: central;
    font: inherit;
  }
  .hire { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 600; white-space: nowrap; }
  .mail-icon {
    width: 1.375rem;
    height: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (max-width: 40rem) {
    .top { gap: 0.5rem; padding-inline: calc(var(--frame-w) + 0.625rem); }
    .brand, .hire-label { display: none; }
    .nav { margin-inline: 0 auto; }
    .nav-link { padding: 0.625rem 0.75rem; }
    .hire { margin-left: auto; padding: 0.6875rem; }
  }
  .skip {
    position: fixed;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 400;
    padding: 0.625rem 0.875rem;
    background: var(--color-ink);
    color: var(--color-cream);
    transform: translateY(-200%);
  }
  .skip:focus-visible { transform: none; }
</style>

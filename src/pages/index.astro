---
// The first page: one full screen, read top to bottom: Mumbai time, what
// I'm doing now, the numbered menu and a "Next page" ring along the top;
// the name huge in display caps with role and a short intro under it; the
// copper ticker across the bottom. Socials run vertically down the right
// edge, and the day/night switch sits in the top-right corner.
import { getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import Ticker from '../components/Ticker.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import SoundToggle from '../components/SoundToggle.astro'
import { site } from '../site'

const page = (await getEntry('index', 'index'))!.data
// The menu skips "Start": you're already on it.
const menu = site.nav.slice(1)
---

<Base ogTitle={page.seo.title} description={page.seo.description}>
  <main id="main">
    <section class="top">
      <div class="wrap base">
        <div data-reveal="150" class="block">
          <span class="label">Local time</span>
          <!-- "--:--" in the HTML so it never shows a stale time; the script fills it in. -->
          <p class="tnum">{site.city} <span id="clock">--:--</span></p>
        </div>
        <div data-reveal="200" class="block">
          <span class="label">{page.now.label}</span>
          <p>{page.now.value}</p>
        </div>
        <nav data-reveal="250" class="block menu" aria-label="Main">
          <span class="label">Menu</span>
          <ol>
            {menu.map((link, i) => (
              <li>
                <a href={link.to} class="menu-link">
                  <span class="tnum">{String(i + 1).padStart(2, '0')}</span>
                  <span class="line-link">{link.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <div data-reveal="300" class="next">
          <a href="/about" class="dot-link">
            <span class="ring" aria-hidden="true"></span>
            Next page
          </a>
        </div>
      </div>

      <div class="wrap hero">
        <!-- The name fills with Mumbai footage once it has risen in
             (scripts/name-reel.ts); the text stays real for readers. -->
        <div class="name-wrap" data-name-reel>
          <h1 class="display name">
            <span class="mask-line"><span data-reveal="400" data-from="105%"><span class="word">Richie</span> <span class="word">Patil</span></span></span>
          </h1>
        </div>
        <p data-reveal="550" class="role">
          <span>{page.role}</span>
          <span>{page.location}</span>
        </p>
        <p data-reveal="650" class="lead">{page.lead}</p>
      </div>

      <div class="ticker-wrap">
        <Ticker phrases={page.ticker} />
      </div>

      <div class="side">
        {site.socials.map(social => (
          <a href={social.to} target="_blank" rel="noopener" class="line-link">{social.label}</a>
        ))}
      </div>
      <div class="corner">
        <SoundToggle />
        <ThemeToggle />
      </div>
    </section>
  </main>
</Base>

<script>
  import '../scripts/name-reel'
</script>

<script>
  // Mumbai local time as HH:MM, ticking once a second.
  const clock = document.getElementById('clock')
  const format = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' })
  const tick = () => {
    if (clock) clock.textContent = format.format(new Date())
  }
  tick()
  setInterval(tick, 1000)
</script>

<style>
  .top {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    color: var(--color-accent);
  }
  /* A little further in than the page gutter. */
  .ticker-wrap {
    padding: 0 calc(var(--gutter) + clamp(8px, 1.5vw, 24px)) 64px;
  }
  /* Pushed down so the name and ticker sit at the bottom of the screen. */
  /* Set in from the page edge a little more than the top row, so the
     name block sits slightly to the right. */
  .hero {
    margin-top: auto;
    padding-top: 56px;
    padding-bottom: clamp(64px, 11vh, 120px);
    padding-left: calc(var(--gutter) + clamp(8px, 2.4vw, 44px));
  }
  .name {
    font-size: clamp(54px, 9.9vw, 157px);
    white-space: nowrap;
    transition: color .9s ease;
  }

  /* — the name as a window onto the city — */
  .name-wrap { position: relative; }
  .name-wrap :global(.name-reel) {
    position: absolute;
    inset: -16px 0;
    overflow: hidden;
    container-type: size;
    pointer-events: none;
    opacity: 0;
    transition: opacity .9s ease;
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
  }
  /* The footage covers the name's box. It is sepia, so a little extra
     contrast keeps the letters crisp against the paper. */
  .name-wrap :global(.name-reel video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.12);
  }
  /* Day only: at night the name stays plain taxi-yellow type. */
  :global(html:not([data-mode="dark"])) .name-wrap:global(.is-reel) :global(.name-reel) { opacity: 1; }
  :global(html:not([data-mode="dark"])) .name-wrap:global(.is-reel) .name { color: transparent; }
  .role {
    margin-top: 17px;
    display: flex;
    flex-direction: column;
    font-size: 17px;
    line-height: 1.25;
  }
  .role span:first-child { text-transform: uppercase; }
  .lead {
    margin-top: 45px;
    max-width: 35ch;
    font-size: 15.5px;
    line-height: 1.4;
    color: var(--color-text);
  }
  /* Top row: three labelled blocks that share one top line and one rhythm
     (label, 12px, then 16px text on a 1.5 line), plus the "Next page" ring
     at the right. Clear of the theme toggle in the corner above it. */
  .base {
    padding-block: 72px 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    align-items: start;
    gap: 40px 48px;
  }
  .block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    font-size: 16px;
    line-height: 1.5;
  }
  .block p {
    max-width: 24ch;
    color: var(--color-text);
    /* Line breaks typed in the YAML ("\n") show as line breaks. */
    white-space: pre-line;
  }
  .menu ol {
    display: flex;
    flex-direction: column;
  }
  .menu-link {
    display: grid;
    grid-template-columns: 2.9em auto;
    align-items: center;
  }
  .menu li + li { margin-top: 4px; }
  /* Menu numbers as small platform signs: a hairline box with softly
     rounded corners, in the page's ink. Fills in on hover. */
  .menu-link .tnum {
    justify-self: start;
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    height: 17px;
    padding: 0 4px;
    border: 1px solid currentColor;
    border-radius: 3px;
    color: var(--color-muted);
    font-size: 10.5px;
    letter-spacing: .04em;
    line-height: 1;
    transition: background-color .3s, color .3s, border-color .3s;
  }
  .menu-link:hover .tnum {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }
  .next {
    align-self: start;
    justify-self: end;
  }
  .side {
    position: absolute;
    right: calc(var(--gutter) * .45);
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    display: flex;
    gap: 18px;
    font-size: 15px;
  }
  .corner {
    position: absolute;
    top: 12px;
    right: var(--gutter);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  @media (max-width: 1080px) {
    .base { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .ticker-wrap { padding-bottom: 40px; }
    .hero {
      padding-top: 44px;
      /* 32, not 40: the LED board is a few px taller than the old strip,
         and the page must still fit one phone screen. */
      padding-bottom: 32px;
    }
    .name {
      white-space: normal;
      font-size: clamp(60px, 20vw, 105px);
    }
    .name .word { display: block; }
    .lead { margin-top: 32px; }
    .base {
      padding-block: 56px 0;
      gap: 32px 20px;
    }
    .side { display: none; }
  }
</style>

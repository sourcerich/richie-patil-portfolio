---
import { getCollection, getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import { site } from '../site'

const page = (await getEntry('index', 'index'))!.data
const about = (await getEntry('about', 'about'))!.data
const projects = (await getCollection('projects'))
  .map(entry => entry.data)
  .sort((a, b) => a.order - b.order)

const skillByKey = new Map(page.skills.map(s => [s.key, s]))
const colorOf = (keys: string[]) => skillByKey.get(keys[0]!)?.color ?? '#fff3df'
const num = (i: number) => String(i + 1).padStart(2, '0')
const year = new Date().getFullYear()
const words = (text: string) => text.split(' ')
---

<Base title={page.seo.title} description={page.seo.description}>
  <main id="main">
    <section class="hero wrap">
      <div class="fold">
        <div class="bloom" data-bloom>
          <h1 class="deva mr" aria-label={page.name}>
            {words(page.nameMr).map(word => <span class="ch" data-engine-word data-single aria-hidden="true">{word}</span>)}
          </h1>
        </div>
      </div>
      <ul class="stickers" aria-label="What I do">
        {page.skills.map((s, i) => (
          <li style={`--c: ${s.color}; --r: ${[-6, 4, -3, 7][i % 4]}deg`}>
            <a href={`#skill-${s.key}`} class="sticker">{s.title}</a>
          </li>
        ))}
      </ul>
      <ul class="stats">
        {page.stats.map(s => (
          <li><strong class="display">{s.value}</strong><span>{s.label}</span></li>
        ))}
      </ul>
    </section>

    <section id="skills" class="section wrap" aria-labelledby="skills-title">
      <h2 id="skills-title" class="display h2" data-reveal>What I do</h2>
      <ol class="rows skills">
        {page.skills.map((s, i) => {
          const used = projects.filter(p => p.skills.includes(s.key))
          return (
            <li id={`skill-${s.key}`} class="row skill" style={`--c: ${s.color}`} data-reveal={i * 80}>
              <h3 class="row-title">{s.title}</h3>
              <div class="row-body">
                <p class="lead">{s.body}</p>
                <p class="mono used-label">Proof of work</p>
                <ul class="chips">
                  {used.map(p => <li><a href={`#p-${p.slug}`} class="chip" data-open>{p.title}</a></li>)}
                </ul>
              </div>
            </li>
          )
        })}
      </ol>
    </section>

    <section id="work" class="section wrap" aria-labelledby="work-title">
      <div class="section-head">
        <div>
              <h2 id="work-title" class="display h2" data-reveal>Work</h2>
        </div>
        <p class="lede" data-reveal>Chosen projects</p>
      </div>
      <ol class="rows projects">
        {projects.map((p, i) => (
          <li class="project-cell">
            <article id={`p-${p.slug}`} class="row project" style={`--c: ${colorOf(p.skills)}`} data-reveal={(i % 2) * 80}>
              {p.image && <img class="shot" src={p.image} alt="" loading="lazy" decoding="async" width="1200" height="750">}
              {!p.image && p.confidential && <div class="shot nda"><span class="mono">Client work · under NDA</span></div>}
              <div class="project-body">
                <p class="mono n">{num(i)} · {p.type} · {p.year}</p>
                <h3 class="row-title">{p.title}</h3>
                <p class="metric"><strong class="display">{p.metric}</strong> <span class="mono">{p.metricLabel}</span></p>
                <p class="summary">{p.summary}</p>
                <ul class="tags">{p.tags.map(t => <li class="mono">{t}</li>)}</ul>
                <details class="case">
                  <summary class="pill pill-small"><span class="open-label">See more</span><span class="close-label">See less</span></summary>
                  <dl class="story">
                    <dt class="mono">The problem</dt><dd>{p.problem}</dd>
                    <dt class="mono">What I built</dt><dd>{p.build}</dd>
                    <dt class="mono">The result</dt><dd>{p.outcome}</dd>
                  </dl>
                  {p.gallery && (
                    <div class="gallery">
                      {p.gallery.map(g => <img src={g.src} alt={g.alt} loading="lazy" decoding="async">)}
                    </div>
                  )}
                  <p class="case-links">
                    {p.link && <a href={p.link} class="line-link" target="_blank" rel="noopener">{p.linkLabel ?? 'See it live'} ↗</a>}
                    {!p.link && p.repo && <a href={p.repo} class="line-link" target="_blank" rel="noopener">View the code ↗</a>}
                    {p.confidential && <span class="mono">Confidential client work</span>}
                  </p>
                </details>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </section>

    <section id="about" class="section wrap" aria-labelledby="about-title">
      <h2 id="about-title" class="display h2" data-reveal>About</h2>
      <div class="about">
        <div class="about-main">
          <p class="big" data-reveal>{about.profile}</p>
          <div class="facts" data-reveal>
            <div>
              <h3 class="mono">Stack</h3>
              <p>{about.stack}</p>
            </div>
            <div>
              <h3 class="mono">Recognition</h3>
              <ul>{about.recognition.map(r => <li>{r}</li>)}</ul>
            </div>
            <div>
              <h3 class="mono">Outside work</h3>
              <p>{about.outside}</p>
            </div>
          </div>
        </div>
        <div class="about-side">
          <div class="panel" style="--c: var(--rust)" data-reveal>
            <h3 class="panel-title">{about.approach.title}</h3>
            <p class="mono sub">{about.approach.subtitle}</p>
            <ol class="approach">
              {about.approach.items.map((a, i) => (
                <li><span class="mono n">{num(i)}</span><div><h4>{a.title}</h4><p>{a.body}</p></div></li>
              ))}
            </ol>
          </div>
          <div class="panel" style="--c: var(--olive)" data-reveal>
            <h3 class="panel-title">{about.experience.title}</h3>
            <ol class="jobs">
              {about.experience.items.map(j => (
                <li>
                  <p class="mono when">{j.when}</p>
                  <p class="org"><strong>{j.org}</strong> · {j.role}</p>
                  <p class="note">{j.note}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="section wrap contact" aria-labelledby="contact-title">
      <div class="contact-block" id="contact-card" data-reveal>
        <h2 id="contact-title" class="display h2">{page.contact.title}</h2>
        <p class="big">{page.contact.body}</p>
        <a href={`mailto:${site.email}`} class="mail display">{site.email}</a>
        <ul class="socials">
          {site.socials.map(s => <li><a href={s.to} class="pill" target="_blank" rel="noopener">{s.label} ↗</a></li>)}
        </ul>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <p class="mono">© {year} {site.name} · <span class="deva">{page.nameMr}</span></p>
    <a href="#main" class="mono line-link">Back to top ↑</a>
  </footer>
</Base>

<script>
  import '../scripts/open-case'
</script>

<style>

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: 0;
    padding-bottom: 1.75rem;
  }
  .bloom {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: clamp(1.25rem, 5vh, 3.125rem);
  }
  .fold {
    align-self: stretch;
    min-height: calc(100svh - var(--frame-w) * 2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .mr { position: relative; z-index: 1; pointer-events: none; color: #fff; }
  .ch { display: inline-block; }
  .mr .ch { margin-inline: 0.2em; }
  :global(html.engine-text) .ch { color: transparent; }
  .mr { font-size: clamp(4.5rem, 15vw, 13rem); line-height: 1.1; }
  .sticker { white-space: nowrap; }

  .stickers { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.875rem 0.625rem; margin-top: 2.25rem; }
  .sticker {
    display: inline-block;
    padding: 0.75rem 1.25rem 0.875rem;
    border: 0.15625rem solid var(--color-outline);
    border-radius: 1rem;
    background: var(--c);
    color: var(--color-deep);
    font-weight: 800;
    font-size: clamp(1.125rem, 1.7vw, 1.5rem);
    font-variation-settings: var(--hand-loud);
    box-shadow: 0.25rem 0.25rem 0 var(--color-outline);
    transform: rotate(var(--r));
    transition: transform .4s var(--ease-spring), box-shadow .4s var(--ease-spring);
  }
  .sticker:hover { transform: rotate(0) translateY(-0.375rem) scale(1.05); box-shadow: 0.375rem 0.625rem 0 var(--color-outline); }

  .stats {
    align-self: stretch;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin-top: clamp(2.25rem, 6vh, 4rem);
    text-align: left;
  }
  .stats li { position: relative; display: grid; align-content: start; gap: 0.375rem; padding-top: 1.125rem; }
  .stats li::before, .row::before, .panel::before, .foot::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    border-top: 0.1875rem solid var(--color-outline);
    border-radius: 62.4375rem;
  }
  .stats strong { font-size: clamp(2.25rem, 4.4vw, 4.5rem); color: var(--rust); line-height: 1; }
  .stats span { font-size: 1rem; font-weight: 600; color: var(--color-ink); max-width: 24ch; line-height: 1.35; }

  .section { padding-top: var(--section-y); scroll-margin-top: 2.5rem; }
  .h2 {
    position: relative;
    display: inline-block;
    font-size: clamp(3rem, 9vw, 8.5rem);
    color: var(--color-ink);
  }
  .section-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 0.75rem 2.5rem; }
  .lede { max-width: 26rem; font-size: 1.1875rem; font-weight: 600; padding-bottom: 0.75rem; }

  .rows { display: grid; margin-top: 2.5rem; }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 1rem clamp(1.5rem, 5vw, 6rem);
    align-items: start;
    padding-block: clamp(1.75rem, 4vw, 3.25rem);
    scroll-margin-top: 10rem;
  }
  .row:target { animation: ping .9s var(--ease-out); }
  @keyframes ping {
    30% { transform: translateX(0.5rem); }
  }
  .row-title {
    font-weight: 800;
    font-size: clamp(2.25rem, 5vw, 4.75rem);
    line-height: 1;
    font-variation-settings: var(--hand-loud);
    text-decoration: underline;
    text-decoration-color: var(--c, var(--color-outline));
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.12em;
  }
  .row p { line-height: 1.55; }
  .lead { font-size: clamp(1.1875rem, 1.7vw, 1.625rem); font-weight: 600; line-height: 1.45; max-width: 52ch; }
  .used-label { margin-top: 1.5rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem 0.625rem; margin-top: 0.625rem; }
  .chip {
    display: inline-block;
    padding: 0.3125rem 0.875rem;
    border: 0.125rem solid var(--color-outline);
    border-radius: 62.4375rem;
    font-weight: 600;
    font-size: 0.9375rem;
    transition: background-color .2s, color .2s;
  }
  .chip:hover { background: var(--color-outline); color: var(--color-cream); }

  .projects { gap: 0; }
  .project { grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr); align-items: center; container-type: inline-size; }
  .project-cell:nth-child(even) .project { grid-template-columns: minmax(0, 1fr) minmax(0, 0.6fr); }
  .project-cell:nth-child(even) .shot { order: 2; }
  .project-cell:has(details[open]) .project { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: start; }
  .project-cell:nth-child(even):has(details[open]) .project { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); }
  .project-cell:has(details[open]) .shot { max-height: none; aspect-ratio: 16 / 10; }
  .shot {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    max-height: 15rem;
    object-fit: cover;
    cursor: zoom-in;
    border: 0.1875rem solid var(--color-outline);
    border-radius: 2rem 0.625rem 2.5rem 0.625rem;
    box-shadow: 0.625rem 0.625rem 0 var(--c);
  }
  .nda {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(-45deg, var(--color-outline) 0 0.875rem, color-mix(in srgb, var(--color-outline) 85%, var(--c)) 0.875rem 1.75rem);
    color: var(--color-cream);
  }
  .project-body { display: grid; align-content: start; }
  .project-body .n { color: color-mix(in srgb, var(--color-ink) 70%, transparent); margin-bottom: 0.5rem; }
  .metric { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.375rem 0.875rem; margin-top: 1rem; }
  .metric strong { font-size: clamp(2.25rem, 7cqw, 4rem); line-height: 1.05; white-space: nowrap; color: var(--rust); }
  .summary { margin-top: 0.875rem; font-size: 1.125rem; font-weight: 600; max-width: 52ch; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 1rem; }
  .tags li { padding: 0.25rem 0.625rem; border: 0.09375rem solid var(--color-outline); border-radius: 62.4375rem; font-size: 0.75rem; line-height: 1.3; white-space: nowrap; }
  .case { margin-top: 1.25rem; }
  .case summary { list-style: none; cursor: pointer; }
  .case summary::-webkit-details-marker { display: none; }
  .pill-small { padding: 0.4375rem 0.875rem; font-size: 0.9375rem; background: var(--c); color: var(--color-deep); }
  .close-label, .case[open] .open-label { display: none; }
  .case[open] .close-label { display: inline; }
  .case[open] summary { background: var(--color-outline); color: var(--color-cream); border-color: var(--c); box-shadow: 0.1875rem 0.1875rem 0 var(--c); }
  .case[open] summary:hover { box-shadow: 0.3125rem 0.3125rem 0 var(--c); }
  .case[open] summary:active { box-shadow: 0.0625rem 0.0625rem 0 var(--c); }
  .story { display: grid; grid-template-columns: 6.875rem minmax(0, 68ch); gap: 0.75rem 1rem; margin-top: 1.375rem; }
  .story dt { padding-top: 0.25rem; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.875rem; margin-top: 1.375rem; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 0.125rem solid var(--color-outline); border-radius: 1rem; }
  .case-links { margin-top: 1.125rem; font-weight: 700; }

  .about { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 7rem); margin-top: 2.5rem; align-items: start; }
  .about-main { display: grid; gap: 2.5rem; }
  .about-side { display: grid; gap: 2.5rem; }
  .big { font-size: clamp(1.25rem, 2.1vw, 2rem); line-height: 1.4; font-weight: 600; }
  .panel { position: relative; padding-top: 1.5rem; }
  .panel-title { font-weight: 800; font-size: clamp(1.75rem, 3vw, 2.75rem); line-height: 1.05; font-variation-settings: var(--hand-loud); }
  .panel p { line-height: 1.5; }
  .sub { margin-top: 0.375rem; }
  .approach { display: grid; gap: 1.125rem; margin-top: 1.25rem; }
  .approach li { display: grid; grid-template-columns: 2.4em 1fr; gap: 0.625rem; }
  .approach h4 { font-size: 1.25rem; font-weight: 800; }
  .approach .n { padding-top: 0.25rem; color: var(--rust); }
  .jobs { display: grid; margin-top: 0.875rem; }
  .jobs li { padding: 0.875rem 0; border-top: 0.125rem dashed color-mix(in srgb, var(--color-outline) 40%, transparent); }
  .jobs li:first-child { border-top: 0; }
  .org { font-size: 1.1875rem; margin-top: 0.125rem; }
  .note { margin-top: 0.25rem; color: color-mix(in srgb, var(--color-ink) 80%, transparent); }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1.75rem; }
  .facts h3 { display: inline-block; margin-bottom: 0.625rem; padding-bottom: 0.25rem; border-bottom: 0.1875rem solid var(--rust); }
  .facts ul { display: grid; gap: 0.375rem; }

  .contact-block {
    scroll-margin-top: 6.25rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    container-type: inline-size;
    gap: 1.625rem;
  }
  .contact .h2 { font-size: min(11rem, 17cqw); }
  .contact .big { max-width: 46ch; }
  .mail {
    justify-self: start;
    max-width: 100%;
    font-size: min(5.5rem, 7.2cqw);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--marigold);
    text-decoration-thickness: max(0.25rem, .1em);
    text-underline-offset: .14em;
    transition: color .2s;
  }
  .mail:hover { color: var(--rust); }
  .socials { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .foot {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 4.5rem;
    padding-block: 1.5rem 1rem;
  }

  @media (max-width: 60rem) {
    .about, .row, .project, .project-cell:nth-child(even) .project { grid-template-columns: minmax(0, 1fr); }
    .project-cell:nth-child(even) .shot { order: 0; }
    .shot { aspect-ratio: 16 / 9; max-height: 12rem; }
    .project-cell:has(details[open]) .shot { max-height: none; aspect-ratio: 16 / 10; }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) {
    .mr { font-size: 6.5rem; }
    .mail { font-size: 1.1875rem; }
    .stats { gap: 1.25rem; }
    .story { grid-template-columns: 1fr; gap: 0.25rem; }
    .story dd { margin-bottom: 0.625rem; }
  }
</style>

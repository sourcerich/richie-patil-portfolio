// Cloudflare Workers config: serves the static `astro build` output as
// Workers static assets. No Worker script is needed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "richie-patil-portfolio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Every route is prerendered; anything else gets 404.html (the site's own
    // 404 page) with a real 404 status.
    "not_found_handling": "404-page",
    // Serve /about from about/index.html (no trailing slash), matching the
    // app's links and the sitemap.
    "html_handling": "drop-trailing-slash"
  },
  // Both hostnames must be on a Cloudflare zone in the same account. Send
  // www to the apex with a Redirect Rule in the Cloudflare dashboard.
  "routes": [
    { "pattern": "richiepatil.com", "custom_domain": true },
    { "pattern": "www.richiepatil.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
